        && nw.url is string && nw.url.size() <= 500
        && (nw.url == '' || nw.url.matches('https://[^ ]+'))
        && stamped(nw);
      }
      allow write: if isAdmin() && id == 'introVideo' && _c_introVideo(request.resource.data);
      // Bildirim tetikleyicileri (PROJE.md 7): admin yönetir; acil duyuru ve SOS kapatılamaz.
      // Aynı belgede telefon bildirimi öncelikleri (her zaman / normal / uygulama içi) ve günlük sesli tavan (1-50).
      function _c_notificationTriggers(nw) {
        return nw.keys().hasOnly(['triggers', 'priorities', 'dailySoundCap', 'updatedBy', 'updatedAt'])
        && (!('priorities' in nw) || validPriorities(nw.priorities))
        && (!('dailySoundCap' in nw)
            || (nw.dailySoundCap is int && nw.dailySoundCap >= 1 && nw.dailySoundCap <= 50))
        && validNotificationMap(nw.triggers)
        && nw.triggers.acil == true && nw.triggers.sos == true
        && stamped(nw);
      }
      allow write: if isAdmin() && id == 'notificationTriggers' && _c_notificationTriggers(request.resource.data);
    }

    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    // Harcama (Panel > Harcama, yalnızca admin): status'u sunucu yazar, settings'te sigorta tutarı (TL, 100-100000).
    match /billing/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && id == 'settings'
        && request.resource.data.keys().hasOnly(['cap', 'updatedBy', 'updatedAt'])
        && request.resource.data.cap is int && request.resource.data.cap >= 100 && request.resource.data.cap <= 100000
        && stamped(request.resource.data);
    }

    // ---- Yetkiler (PROJE.md 6.7): admin il yöneticisi, muhtar ve moderatör verir; il yöneticisi kendi ilinde muhtar
    // ve moderatör verir, kendinde olmayan yetkiyi veremez. Admin rolü panelden verilmez (yalnızca konsol, admins).
    // Rol sınırları ortak paketteki ROLE_CAPS ile aynıdır.
    function capsFor(role) {
      return role == 'il-yoneticisi' ? {
          'konumlar': ['goruntule'], 'acil-numaralar': ['goruntule'], 'hizmet-kategorileri': ['goruntule', 'onayla'],
          'kurumlar': ['goruntule'], 'yetkiler': ['goruntule', 'ekle', 'duzenle', 'sil'], 'onaylar': ['goruntule', 'onayla'],
          'islem-kayitlari': ['goruntule'], 'bildirimler': ['goruntule', 'ekle', 'duzenle', 'sil', 'yayinla', 'bildirim-gonder'],
          'gonderiler': ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla', 'yayinla'],
          'etkinlikler': ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla', 'yayinla'],
          'hizmetler': ['goruntule', 'ekle', 'duzenle', 'sil'], 'moderasyon': ['goruntule', 'duzenle', 'sil'],
          'isletme-dogrulama': ['goruntule', 'onayla'], 'sehir-rehberi': ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla']}
        : role == 'muhtar' ? {
          'konumlar': ['goruntule'], 'islem-kayitlari': ['goruntule'], 'gonderiler': ['goruntule', 'ekle', 'duzenle', 'sil', 'yayinla'],
          'etkinlikler': ['goruntule', 'ekle', 'duzenle', 'yayinla'], 'bildirimler': ['goruntule', 'ekle', 'yayinla', 'bildirim-gonder']}
        : {'konumlar': ['goruntule'], 'islem-kayitlari': ['goruntule'], 'moderasyon': ['goruntule', 'duzenle']};
    }
    function within(m, caps, k) {
      return !(k in m) || (m[k] is list && m[k].size() >= 1 && m[k].hasOnly(caps.get(k, [])));
    }
    // Muhtar ve moderatör yetkisinin bölümleri (kuralların hesap sınırı için yalnızca bunlar denetlenir).
    function muhtarWithin(m, caps) {
      return within(m, caps, 'konumlar') && within(m, caps, 'islem-kayitlari') && within(m, caps, 'gonderiler')
        && within(m, caps, 'etkinlikler') && within(m, caps, 'bildirimler');
    }
    function moderatorWithin(m, caps) {
      return within(m, caps, 'konumlar') && within(m, caps, 'islem-kayitlari') && within(m, caps, 'moderasyon');
    }
    // Rolün bölümleri ve eylemleri verilen sınırın içinde mi (rol sınırı ya da verenin kendi yetkisi)?
    function roleModulesWithin(m, role, caps) {
      return m is map && m.size() >= 1 && m.keys().hasOnly(capsFor(role).keys())
        && (role == 'muhtar' ? muhtarWithin(m, caps)
            : role == 'moderator' ? moderatorWithin(m, caps)
            : modulesWithin(m, caps));
    }
    function modulesWithin(m, caps) {
      return m is map && m.size() >= 1 && m.keys().hasOnly(caps.keys())
        && within(m, caps, 'konumlar') && within(m, caps, 'meslekler') && within(m, caps, 'acil-numaralar')
        && within(m, caps, 'hizmet-kategorileri') && within(m, caps, 'sos') && within(m, caps, 'kurumlar')
        && within(m, caps, 'yetkiler') && within(m, caps, 'onaylar') && within(m, caps, 'islem-kayitlari')
        && within(m, caps, 'bildirimler') && within(m, caps, 'gonderiler') && within(m, caps, 'etkinlikler')
        && within(m, caps, 'hizmetler') && within(m, caps, 'moderasyon') && within(m, caps, 'isletme-dogrulama')
        && within(m, caps, 'sehir-rehberi');
    }
    function validScope(sc) {
      return sc is map && (
        (sc.level == 'ulke' && sc.keys().hasOnly(['level']))
        || (sc.level == 'il' && sc.keys().hasOnly(['level', 'provinceCode'])
            && sc.provinceCode is string && sc.provinceCode.matches('^[0-8][0-9]$'))
        || (sc.level == 'ilce' && sc.keys().hasOnly(['level', 'provinceCode', 'districtId'])
            && sc.provinceCode is string && sc.provinceCode.matches('^[0-8][0-9]$')
            && sc.districtId is string && sc.districtId.matches('^' + sc.provinceCode + '-[a-z0-9-]+$'))
        || (sc.level == 'mahalle' && sc.keys().hasOnly(['level', 'provinceCode', 'districtId', 'neighbourhoodId'])
            && sc.provinceCode is string && sc.provinceCode.matches('^[0-8][0-9]$')
            && sc.districtId is string && sc.districtId.matches('^' + sc.provinceCode + '-[a-z0-9-]+$')
            && sc.neighbourhoodId is string && sc.neighbourhoodId.matches('^' + sc.districtId + '-.+$')));
    }
    function scopeKeyOf(sc) {
      return sc.level == 'ulke' ? 'ulke'
        : sc.level == 'il' ? 'il-' + sc.provinceCode
        : sc.level == 'ilce' ? 'ilce-' + sc.districtId
        : 'mahalle-' + sc.neighbourhoodId;
    }
    function roleFitsScope(role, level) {
      return (role == 'il-yoneticisi' && level == 'il')
        || (role == 'muhtar' && level == 'mahalle')
        || (role == 'moderator' && level in ['il', 'ilce', 'mahalle']);
    }
    function validEmail(e) {
      return e is string && e.size() <= 120 && e.matches('^[^@ A-Z]+@[^@ A-Z]+[.][^@ A-Z]+$');
    }
    function validGrant(id, d) {
      return d.keys().hasOnly(['email', 'displayName', 'note', 'role', 'scope', 'modules', 'expiresAt',
             'grantedBy', 'grantedAt', 'updatedAt', 'revokedAt', 'revokedBy'])
        && validEmail(d.email)
        // Kimse kendine yetki veremez.
        && d.email != request.auth.token.get('email', '')
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 80
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && validScope(d.scope)
        && roleFitsScope(d.role, d.scope.level)
        && id == d.email + '__' + scopeKeyOf(d.scope)
        && roleModulesWithin(d.modules, d.role, capsFor(d.role))
        && (!('expiresAt' in d) || d.expiresAt is timestamp)
        && d.grantedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    // Bu ilde il yöneticisiyim ve bu eylemde yetki yönetebilirim.
    function provinceManager(provinceCode, action) {
      return grantAllows('il-' + provinceCode, 'yetkiler', action)
        && get(grantPath('il-' + provinceCode)).data.role == 'il-yoneticisi';
    }
    function canGrant(d) {
      return isAdmin()
        || (d.role in ['muhtar', 'moderator'] && d.scope.level != 'ulke'
            && provinceManager(d.scope.provinceCode, 'ekle')
            // Kimse kendinde olmayan yetkiyi veremez.
            && (d.role == 'muhtar' ? muhtarWithin(d.modules, get(grantPath('il-' + d.scope.provinceCode)).data.modules)
                : moderatorWithin(d.modules, get(grantPath('il-' + d.scope.provinceCode)).data.modules)));
    }

    match /grants/{id} {
      // Kişi kendi yetkilerini görür (panel menüsü bundan kurulur); il yöneticisi kendi ilindekileri; admin hepsini.
      allow read: if isAdmin()
        || (verified() && (resource == null || resource.data.email == myEmail()))
        || provinceManager(resource.data.scope.provinceCode, 'goruntule');
      // Verme / değiştirme / yeniden verme: belgenin tamamı yazılır, geri alma bilgisi temizlenir. İl yöneticisi başka
      // bir il yöneticisinin yetkisinin üstüne yazamaz.
      // (Ucuz denetimler önce: kuralların hesap sınırı aşılmasın.)
      function _k50(nw) {
        return !('revokedAt' in nw) && !('revokedBy' in nw)
        && nw.grantedAt == request.time
        && validGrant(id, nw)
        && canGrant(nw)
        && (resource == null || isAdmin() || resource.data.role in ['muhtar', 'moderator']);
      }
      allow create, update: if _k50(request.resource.data);
      // Geri alma: yalnızca geri alma bilgisi eklenir, yetkinin içeriği değişmez.
      function _k51(nw, od) {
        return od.get('revokedAt', null) == null
        && nw.diff(od).affectedKeys().hasOnly(['revokedAt', 'revokedBy', 'updatedAt'])
        && nw.revokedAt == request.time
        && nw.revokedBy == request.auth.uid
        && nw.updatedAt == request.time
        && (isAdmin()
            || (od.role in ['muhtar', 'moderator'] && od.scope.level != 'ulke'
                && provinceManager(od.scope.provinceCode, 'sil')));
      }
      allow update: if _k51(request.resource.data, resource.data);
      // Silinmez: geçmiş yetkiler denetim için kalır.
      allow delete: if false;
    }

    // ---- Kurumlar (PROJE.md 6.6-6.7): yalnızca admin açar. Kurum yöneticisi kendi personeline, kurumun bölgesi ve
    // bölümleri içinde görev verir; yeni kurum yöneticisini admin atar. Pasif ya da sözleşmesi biten kurumda kimse çalışamaz.
    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }
    function memberPath(orgId) {
      return /databases/$(database)/documents/orgMembers/$(orgId + '__' + myEmail());
    }
    function memberActive(m) {
      return m.get('removedAt', null) == null && (m.get('expiresAt', null) == null || m.expiresAt > request.time);
    }
    function orgActive(o) {
      return o.status == 'aktif' && (o.get('contractEndsAt', null) == null || o.contractEndsAt > request.time);
    }
    function isMemberOf(orgId) {
      return verified() && exists(memberPath(orgId)) && memberActive(get(memberPath(orgId)).data)
        && exists(orgPath(orgId)) && orgActive(get(orgPath(orgId)).data);
    }
    function isOrgAdminOf(orgId) {
      return isMemberOf(orgId) && get(memberPath(orgId)).data.isOrgAdmin == true;
    }
    function validOrg(id, d) {
      return d.keys().hasOnly(['name', 'kind', 'scope', 'modules', 'officialEmail', 'status', 'contractEndsAt',
             'createdBy', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.kind in ['buyuksehir-belediyesi', 'il-belediyesi', 'ilce-belediyesi', 'kurum', 'kulup', 'yayinci']
        // Belediyeler kilitli ad listesindeki kimlikle açılır (aynı belediye iki kez açılamaz).
        && (d.kind in ['buyuksehir-belediyesi', 'il-belediyesi', 'ilce-belediyesi']) == id.matches('^bld-[0-9]{2}(-[a-z0-9-]+)?$')
        && (id.matches('^bld-.+') || id.matches('^krm-[a-z0-9-]{2,80}$'))
        && validScope(d.scope)
        && d.modules is list && d.modules.hasOnly(['gonderiler', 'etkinlikler', 'bildirimler', 'hizmetler', 'seyahat', 'istatistik', 'baskan'])
        // Seyahat (Başkanlarla Keşif) ve Belediye başkanı yalnızca belediyelere.
        && (!d.modules.hasAny(['seyahat', 'baskan']) || d.kind in ['buyuksehir-belediyesi', 'il-belediyesi', 'ilce-belediyesi'])
        && validEmail(d.officialEmail)
        && d.status in ['aktif', 'pasif']
        && (!('contractEndsAt' in d) || d.contractEndsAt is timestamp)
        && d.updatedAt == request.time;
    }

    match /organizations/{id} {
      allow read: if isAdmin() || isMemberOf(id)
        || grantAllows('il-' + resource.data.scope.provinceCode, 'kurumlar', 'goruntule');
      function _k52(nw) {
        return isAdmin() && validOrg(id, nw)
        && nw.status == 'aktif'
        && nw.createdBy == request.auth.uid
        && nw.createdAt == request.time;
      }
      allow create: if _k52(request.resource.data);
      function _k53(nw) {
        return isAdmin() && validOrg(id, nw)
        && nw.diff(resource.data).affectedKeys().hasOnly(['status', 'modules', 'contractEndsAt', 'updatedAt']);
      }
      allow update: if _k53(request.resource.data);
      allow delete: if false;
    }

    // Görev: bölüm başına işaretlenen eylemler (Karar, Eren, 27 Ekim 2026). "Bildirim gönder" yalnızca bildirimlerde.
    function validAssignment(a, k) {
      return !(k in a) || (a[k] is list && a[k].size() >= 1
        && a[k].hasOnly(k == 'bildirimler'
            ? ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla', 'yayinla', 'bildirim-gonder']
            : ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla', 'yayinla']));
    }
    function validMember(id, d) {
      return d.keys().hasOnly(['orgId', 'email', 'displayName', 'isOrgAdmin', 'assignments', 'expiresAt', 'addedBy', 'updatedAt'])
        // Kurum aynı toplu yazımda açılıyor olabilir (kurum + kurum yöneticisi), bu yüzden yazım sonrası durum okunur.
        && d.orgId is string && existsAfter(orgPath(d.orgId))
        && validEmail(d.email)
        && id == d.orgId + '__' + d.email
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 80
        && d.isOrgAdmin is bool
        && d.assignments is map && d.assignments.keys().hasOnly(getAfter(orgPath(d.orgId)).data.modules)
        && validAssignment(d.assignments, 'gonderiler') && validAssignment(d.assignments, 'etkinlikler')
        && validAssignment(d.assignments, 'bildirimler') && validAssignment(d.assignments, 'hizmetler')
        && validAssignment(d.assignments, 'seyahat') && validAssignment(d.assignments, 'istatistik')
        && validAssignment(d.assignments, 'baskan')
        && (!('expiresAt' in d) || d.expiresAt is timestamp)
        && d.addedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /orgMembers/{id} {
      // Kişi kendi görevlerini, kurum yöneticisi kendi kurumunun personelini, admin hepsini görür.
      allow read: if isAdmin()
        || (verified() && (resource == null || resource.data.email == myEmail()))
        || isOrgAdminOf(resource.data.orgId);
      // Ekleme / görev değiştirme / yeniden ekleme. Kurum yöneticisi kendi kaydını ve başka bir kurum yöneticisini
      // değiştiremez, kurum yöneticisi atayamaz.
      function _k54(nw) {
        return validMember(id, nw)
        && (isAdmin()
            || (isOrgAdminOf(nw.orgId)
                && nw.isOrgAdmin == false
                && nw.email != myEmail()
                && (resource == null || resource.data.isOrgAdmin == false)));
      }
      allow create, update: if _k54(request.resource.data);
      // Çıkarma: yalnızca çıkarma bilgisi eklenir.
      function _k55(nw, od) {
        return (isAdmin() || (isOrgAdminOf(od.orgId) && od.isOrgAdmin == false))
        && od.get('removedAt', null) == null
        && nw.diff(od).affectedKeys().hasOnly(['removedAt', 'removedBy', 'updatedAt'])
        && nw.removedAt == request.time
        && nw.removedBy == request.auth.uid
        && nw.updatedAt == request.time;
      }
      allow update: if _k55(request.resource.data, resource.data);
      allow delete: if false;
    }

    // ---- Benim Şehrim sabit bilgileri (müzeler, otoparklar...): il başına bölüm paketleri. Herkes okur (girişsiz de);
    // admin ve o ilde şehir rehberi yetkisi olan (il yöneticisi) yazar. Ülke geneli içerik ("tr") yalnızca admin'de.
    function canEditGuide(p) {
      return isAdmin() || (p is string && p != 'tr' && provinceAllows('sehir-rehberi', 'duzenle', p));
    }
    function guideSection(s) {
      return s in ['onemli-kurumlar', 'muzeler', 'otoparklar', 'parklar', 'pazarlar', 'ulasim', 'toplanma-alanlari',
                   'muhtarliklar', 'belediye-hizmetleri', 'nasil-yapilir'];
    }
    match /cityGuide/{p} {
      allow read: if true;
      function _k56(nw) {
        return (p == 'tr' || p.matches('^[0-8][0-9]$')) && canEditGuide(p)
        && nw.keys().hasOnly(['sections', 'updatedAt', 'updatedBy'])
        && nw.sections is map && nw.sections.keys().size() <= 10
        && stamped(nw);
      }
      allow create, update: if _k56(request.resource.data);
      allow delete: if false;
    }
    // Şehir Vitrini (haftalık seçki): yayındakini herkes okur; o ilin şehir rehberi yetkisi olan (admin, il yöneticisi) yazar.
    function validShowcase(d) {
      return d.keys().hasOnly(['provinceCode', 'issue', 'title', 'intro', 'weekOf', 'stories', 'status', 'updatedAt'])
        && d.provinceCode is string && d.provinceCode.matches('^[0-8][0-9]$')
        && d.issue is int && d.issue >= 1 && d.issue <= 10000
        && d.title is string && d.title.size() >= 2 && d.title.size() <= 80
        && d.intro is string && d.intro.size() <= 400
        && d.weekOf is string && d.weekOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.stories is list && d.stories.size() >= 1 && d.stories.size() <= 8
        && d.status in ['taslak', 'yayinda']
        && d.updatedAt == request.time;
    }
    match /cityShowcases/{id} {
      allow read: if resource == null || resource.data.status == 'yayinda' || canEditGuide(resource.data.provinceCode);
      function _k57(nw) {
        return validShowcase(nw) && canEditGuide(nw.provinceCode)
        && (resource == null || resource.data.provinceCode == nw.provinceCode);
      }
      allow create, update: if _k57(request.resource.data);
      allow delete: if canEditGuide(resource.data.provinceCode);
    }
    // Yoldayım: OpenStreetMap'ten hazırlanan yol üstü yerler (akaryakıt, şarj, dinlenme tesisi), 3 harflik geohash
    // hücresi başına bir paket. Herkes okur (girişsiz de); yalnızca admin yükler.
    match /roadsidePacks/{cell} {
      allow read: if true;
      function _k58(nw) {
        return isAdmin() && cell.matches('^[0-9b-hjkmnp-z]{3}$')
        && nw.keys().hasOnly(['cell', 'items', 'count', 'source', 'updatedAt', 'updatedBy'])
        && nw.cell == cell
        && nw.items is list && nw.items.size() <= 2500
        && nw.count == nw.items.size()
        && nw.source == 'osm'
        && stamped(nw);
      }
      allow create, update: if _k58(request.resource.data);
      allow delete: if isAdmin();
    }
    match /cityGuidePacks/{id} {
      allow read: if true;
      function _k59(nw) {
        return canEditGuide(nw.provinceCode)
        && nw.keys().hasOnly(['provinceCode', 'section', 'part', 'items', 'updatedAt', 'updatedBy'])
        && guideSection(nw.section)
        && nw.part is int && nw.part >= 0 && nw.part < 50
        && id == nw.provinceCode + '__' + nw.section + '__' + string(nw.part)
        && nw.items is list && nw.items.size() <= 400
        && stamped(nw);
      }
      allow create, update: if _k59(request.resource.data);
      allow delete: if canEditGuide(resource.data.provinceCode);
    }

    // ---- Onay merkezi (PROJE.md 6.5, 6.7): onay gereken iş önce il yöneticisinin (1. aşama), sonra admin'in onayından
    // geçer. approvals/{tür}__{hedef}: aynı iş için tek istek. Şimdilik yalnızca işletme doğrulaması açık.
    function validApproval(id, d) {
      return d.keys().hasOnly(['kind', 'module', 'targetId', 'title', 'region', 'status', 'requestedBy', 'requestedAt',
             'note', 'firstApproval', 'decision', 'updatedAt'])
        && d.kind == 'isletme-dogrulama' && d.module == 'isletme-dogrulama'
        && d.targetId is string && id == d.kind + '__' + d.targetId
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && validLocation(d.region) && 'districtId' in d.region && !('neighbourhoodId' in d.region)
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && d.requestedAt == request.time
        && d.updatedAt == request.time;
    }
    // Hedef işletme var, adı ve yeri istekteki gibi, henüz doğrulanmamış.
    function businessTargetOk(d) {
      return exists(businessPath(d.targetId))
        && get(businessPath(d.targetId)).data.name == d.title
        && get(businessPath(d.targetId)).data.location.provinceCode == d.region.provinceCode
        && get(businessPath(d.targetId)).data.location.districtId == d.region.districtId
        && get(businessPath(d.targetId)).data.verification.status != 'dogrulandi';
    }
    function isBusinessOwner(bid) {
      return signedIn() && exists(businessPath(bid)) && get(businessPath(bid)).data.ownerUid == request.auth.uid;
    }
    // İlk aşama onayı: onaylayan kendisi, e-postası (güvenilir yönetici listesiyle eşleşir) ve şimdiki zaman.
    function myStep(f) {
      return f is map && f.keys().hasOnly(['uid', 'email', 'name', 'at'])
        && f.uid == request.auth.uid && f.email == request.auth.token.get('email', '')
        && f.name is string && f.name.size() >= 1 && f.name.size() <= 80
        && f.at == request.time;
    }
    function myDecision(dec, stage, rejected) {
      return dec is map && dec.keys().hasOnly(['uid', 'at', 'stage', 'reason'])
        && dec.uid == request.auth.uid && dec.at == request.time && dec.stage == stage
        && (rejected ? (dec.reason is string && dec.reason.size() >= 5 && dec.reason.size() <= 300) : !('reason' in dec));
    }

    match /approvals/{id} {
