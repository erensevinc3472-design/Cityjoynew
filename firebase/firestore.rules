rules_version = '2';

// CityJoy veritabanı güvenlik kuralları.
// İlke: varsayılan kapalı; her koleksiyon açıkça izin verilen kadarını açar. Yetki kontrolü burada,
// sunucuda yapılır (ekranda gizlemek yetmez). Yayın: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin listesi yalnızca Firebase konsolundan (ya da sunucudan) yazılır.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- Kişi yetkileri (PROJE.md 6.7): grants/{e-posta}__{bölge}. Kişi doğrulanmış e-postasıyla tanınır;
    // kimlik tahmin edilebilir olduğu için "bu kişinin Bursa yetkisi var mı?" tek okumayla denetlenir. ----
    function verified() {
      return signedIn() && request.auth.token.get('email', null) is string
        && request.auth.token.get('email_verified', false) == true;
    }
    function myEmail() {
      return request.auth.token.email;
    }
    function grantPath(key) {
      return /databases/$(database)/documents/grants/$(myEmail() + '__' + key);
    }
    function grantOk(g, module, action) {
      return g.get('revokedAt', null) == null
        && (g.get('expiresAt', null) == null || g.expiresAt > request.time)
        && g.modules.get(module, []).hasAny([action]);
    }
    function grantAllows(key, module, action) {
      return verified() && exists(grantPath(key)) && grantOk(get(grantPath(key)).data, module, action);
    }
    // Admin ya da ülke / il / (verilirse) ilçe kapsamlı geçerli yetki.
    function regionAllows(module, action, provinceCode, districtId) {
      return isAdmin()
        || (verified() && (grantAllows('ulke', module, action)
            || (provinceCode is string && grantAllows('il-' + provinceCode, module, action))
            || (districtId is string && grantAllows('ilce-' + districtId, module, action))));
    }

    function ageOf(birthYear) {
      return request.time.year() - birthYear;
    }

    function validConsent(c) {
      return c is map
        && c.keys().hasOnly(['granted', 'at', 'textVersion'])
        && c.granted is bool && c.at is string && c.textVersion is string;
    }

    function validLocation(loc) {
      return loc is map
        && loc.keys().hasOnly(['provinceCode', 'districtId', 'neighbourhoodId'])
        && loc.provinceCode is string && loc.provinceCode.matches('^[0-8][0-9]$')
        && (!('districtId' in loc) || (loc.districtId is string && loc.districtId.matches('^' + loc.provinceCode + '-.+')))
        && (!('neighbourhoodId' in loc) || ('districtId' in loc && loc.neighbourhoodId is string
              && loc.neighbourhoodId.matches('^' + loc.districtId + '-.+')));
    }

    // Kullanıcının özel profili (yaş, cinsiyet, meslek, mahalle). Yalnızca sahibi okur ve yazar.
    function validProfile(d) {
      return d.keys().hasOnly([
          'uid', 'displayName', 'language', 'location', 'locationChangedAt', 'birthYear', 'gender',
          'occupationId', 'interests', 'phoneVerified', 'emailVerified', 'isPrivate', 'consents',
          'createdAt', 'updatedAt'])
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 60
        && d.language in ['tr', 'en', 'de', 'ar', 'ru']
        && d.birthYear is int && ageOf(d.birthYear) >= 13 && ageOf(d.birthYear) <= 120
        && (!('gender' in d) || d.gender in ['kadin', 'erkek', 'belirtmek-istemiyorum'])
        && (!('occupationId' in d) || (d.occupationId is string && d.occupationId.size() <= 60))
        && (!('interests' in d) || (d.interests is list && d.interests.size() <= 20))
        && (!('location' in d) || validLocation(d.location))
        && d.isPrivate is bool
        // 13-17 yaş hesapları gizli kalır.
        && (ageOf(d.birthYear) >= 18 || d.isPrivate == true)
        && d.consents is map
        && d.consents.keys().hasOnly(['terms', 'privacyNotice', 'targeting', 'commercialMessages'])
        && validConsent(d.consents.terms) && d.consents.terms.granted == true
        && validConsent(d.consents.privacyNotice) && d.consents.privacyNotice.granted == true
        && (!('targeting' in d.consents) || validConsent(d.consents.targeting))
        && (!('commercialMessages' in d.consents) || validConsent(d.consents.commercialMessages))
        // 18 yaş altına kampanya izni verilmez.
        && (ageOf(d.birthYear) >= 18 || !('commercialMessages' in d.consents) || d.consents.commercialMessages.granted == false)
        && d.updatedAt == request.time;
    }

    function neighbourhoodOf(d) {
      return ('location' in d && 'neighbourhoodId' in d.location) ? d.location.neighbourhoodId : null;
    }

    // Mahalle ayda bir kez değiştirilebilir (Keşfet kuralı 5); ilk seçim serbesttir.
    function neighbourhoodChangeAllowed(before, after) {
      return neighbourhoodOf(before) == neighbourhoodOf(after)
        ? after.get('locationChangedAt', null) == before.get('locationChangedAt', null)
        : after.locationChangedAt == request.time
          && (neighbourhoodOf(before) == null
              || before.get('locationChangedAt', null) == null
              || request.time > before.locationChangedAt + duration.value(30, 'd'));
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && validProfile(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.phoneVerified == false
        && request.resource.data.emailVerified == false
        && (neighbourhoodOf(request.resource.data) == null || request.resource.data.locationChangedAt == request.time);
      allow update: if isSelf(uid)
        && validProfile(request.resource.data)
        // Değiştirilemeyen alanlar: kimlik, doğum yılı (yaş kilidi), oluşturma tarihi, doğrulama durumları.
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['uid', 'birthYear', 'createdAt', 'phoneVerified', 'emailVerified'])
        && neighbourhoodChangeAllowed(resource.data, request.resource.data);
      // Hesap silme uygulama içinden yapılır (mağaza zorunluluğu).
      allow delete: if isSelf(uid);

      // Keşfet'te kaydedilen gönderiler: yalnızca kişinin kendisi.
      match /savedPosts/{postId} {
        allow read, delete: if isSelf(uid);
        allow create: if isSelf(uid) && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }

      // Bildirim tercihleri (PROJE.md 5.12): yalnızca kişinin kendisi; kategori aç/kapa ve sessiz saatler.
      match /settings/{id} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && id == 'notifications'
          && request.resource.data.keys().hasOnly(['categories', 'quietHours', 'updatedAt'])
          && validNotificationMap(request.resource.data.categories)
          && request.resource.data.quietHours is map
          && request.resource.data.quietHours.keys().hasOnly(['enabled', 'start', 'end'])
          && request.resource.data.quietHours.enabled is bool
          && request.resource.data.quietHours.start is int && request.resource.data.quietHours.start >= 0 && request.resource.data.quietHours.start <= 23
          && request.resource.data.quietHours.end is int && request.resource.data.quietHours.end >= 0 && request.resource.data.quietHours.end <= 23
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Meslek listesi: herkes okur (kayıt ekranı), yalnızca admin yönetir.
    match /occupations/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['names', 'order', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.names is map && request.resource.data.names.tr is string
        && request.resource.data.order is int && request.resource.data.active is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false; // Silmek yerine pasifleştirilir; seçmiş kullanıcıların kaydı bozulmaz.
    }

    function validLocalized(t) {
      return t is map && t.keys().hasOnly(['tr', 'en', 'de', 'ar', 'ru'])
        && t.tr is string && t.tr.size() >= 1 && t.tr.size() <= 80;
    }

    // Acil numaralar (ülke geneli): herkes okur, girişsiz de (acil durumda hesap şartı olmaz).
    // Yalnızca admin yönetir; silinmez, pasifleştirilir.
    match /emergencyNumbers/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['number', 'names', 'notes', 'icon', 'order', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.number is string && request.resource.data.number.matches('^[0-9]{3,15}$')
        && validLocalized(request.resource.data.names)
        && (!('notes' in request.resource.data) || validLocalized(request.resource.data.notes))
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 40
        && request.resource.data.order is int && request.resource.data.active is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Hizmet kategorileri (ülke geneli, iki seviye): herkes okur, yalnızca admin yönetir; silinmez.
    // Alt kategorinin üstü var olan bir ana kategori olmalı (üç seviye kurulamaz).
    match /serviceCategories/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['parentId', 'names', 'icon', 'order', 'active', 'urgent', 'updatedAt', 'updatedBy'])
        && validLocalized(request.resource.data.names)
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 40
        && request.resource.data.order is int && request.resource.data.active is bool
        && (!('urgent' in request.resource.data) || request.resource.data.urgent is bool)
        && (request.resource.data.parentId == null
            || (request.resource.data.parentId is string && request.resource.data.parentId != id
                && existsAfter(/databases/$(database)/documents/serviceCategories/$(request.resource.data.parentId))
                && getAfter(/databases/$(database)/documents/serviceCategories/$(request.resource.data.parentId)).data.parentId == null))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Liste sürüm damgaları: uygulama tek okumayla listenin değişip değişmediğine bakar (maliyet ilkesi).
    match /catalogVersions/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // "Eksik hizmet mi var? Bildir": giriş yapmış kullanıcı gönderir, admin okur ve "incelendi" yapar.
    match /serviceSuggestions/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'provinceCode', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 300
        && (!('provinceCode' in request.resource.data)
            || (request.resource.data.provinceCode is string && request.resource.data.provinceCode.matches('^[0-8][0-9]$')))
        && request.resource.data.status == 'yeni'
        && request.resource.data.createdAt == request.time;
      // Admin hepsini, il yöneticisi kendi ilininkileri görür ve "incelendi" yapar.
      allow read: if isAdmin()
        || (resource.data.get('provinceCode', null) != null
            && regionAllows('hizmet-kategorileri', 'goruntule', resource.data.provinceCode, null));
      allow update: if (isAdmin()
            || (resource.data.get('provinceCode', null) != null
                && regionAllows('hizmet-kategorileri', 'onayla', resource.data.provinceCode, null)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status == 'incelendi'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // Kilitli adlar (PROJE.md 6.7): belediye ve resmî kurum sözcükleri kullanıcı adlarında kullanılamaz.
    // Ortak paketteki RESERVED_WORDS ile aynı; Türkçe harfler büyük/küçük ve aksanlı/aksansız eşleşir.
    function reservedName(n) {
      return n.lower().matches('.*(b[e]l[e]d[iİıİ]y[e]|v[aâ]l[iİıİ]l[iİıİ][kğg]|k[aâ]ym[aâ]k[aâ]ml[iİıİ][kğg]|m[uü]ht[aâ]rl[iİıİ][kğg]|c[iİıİ]ty ?j[oö]y|tr[aâ]v[e]l ?j[oö]y).*');
    }

    // İşletmeler (PROJE.md 5.6-5.7). Sahibi bilgilerini yazar; doğrulama, üyelik kademesi, puan ve öne çıkma
    // yalnızca yönetimce (ve ileride sunucu işlevleriyle) değişir.
    function validBusinessContent(d) {
      return d.type in ['hizmet', 'esnaf', 'evden-uretim', 'yeme-icme', 'konaklama', 'yol-ustu', 'emlak']
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80 && !reservedName(d.name)
        && d.categoryIds is list && d.categoryIds.size() >= 1 && d.categoryIds.size() <= 5
        && validLocation(d.location) && 'districtId' in d.location
        && (!('address' in d) || (d.address is string && d.address.size() <= 200 && d.type != 'evden-uretim'))
        && d.phone is string && d.phone.matches('^[0-9]{10,13}$')
        && d.whatsapp is bool && d.is24h is bool
        && (!('hoursNote' in d) || (d.hoursNote is string && d.hoursNote.size() <= 120))
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && d.priceList is list && d.priceList.size() <= 30
        && (!('weeklyHours' in d) || (d.weeklyHours is list && d.weeklyHours.size() == 7))
        && (!('paymentMethods' in d) || (d.paymentMethods is list
              && d.paymentMethods.hasOnly(['nakit', 'kart', 'temassiz', 'yemek-karti', 'havale'])))
        && (!('amenities' in d) || (d.amenities is list && d.amenities.hasOnly(['paket-servis', 'aile-alani',
              'engelli-erisimi', 'otopark', 'wifi', 'cocuk-dostu', 'evcil-hayvan', 'rezervasyon'])))
        && validSearchKeys(d, 60)
        && validRoadside(d);
    }

    // Yol üstü tesis (Yol Arkadaşı): olanaklar listeden; işaretlenmişse (ve "yol-ustu" türünde her zaman) olanak ve
    // Türkiye içinde bir konum zorunlu. Konum yalnızca yol üstü tesiste tutulur.
    function validRoadside(d) {
      let on = d.type == 'yol-ustu' || 'roadside' in d;
      return (!('roadside' in d) || (d.roadside is list && d.roadside.size() >= 1 && d.roadside.size() <= 11
              && d.roadside.hasOnly(['tuvalet', 'akaryakit', 'lpg', 'sarj', 'restoran', 'kafe', 'mescit', 'market',
                'oyun-alani', 'bebek-bakim', 'hediyelik'])))
        && (!on || ('roadside' in d && 'geo' in d))
        && (!('geo' in d) || (on && validGeo(d.geo)));
    }
    function validGeo(g) {
      return g is map && g.keys().hasOnly(['lat', 'lng', 'geohash']) && g.keys().hasAll(['lat', 'lng', 'geohash'])
        && g.lat is number && g.lat >= 35.5 && g.lat <= 42.5
        && g.lng is number && g.lng >= 25.5 && g.lng <= 45
        && g.geohash is string && g.geohash.matches('^[0-9b-hjkmnp-z]{9}$');
    }

    // İşletme yetkilileri (en çok 3; sahibi atar): kimlik listesi + izin haritası birlikte tutarlı olmalı.
    function validManager(m) {
      return m is map && m.keys().hasOnly(['name', 'post', 'edit', 'reply'])
        && m.name is string && m.name.size() <= 40
        && m.post in ['kapali', 'onayla', 'dogrudan'] && m.edit is bool && m.reply is bool;
    }
    function validManagers(d) {
      let u = d.get('managerUids', []);
      let m = d.get('managers', {});
      return u is list && u.size() <= 3 && m is map && m.size() == u.size() && m.keys().hasAll(u)
        && !(d.ownerUid in u)
        && (u.size() < 1 || validManager(m[u[0]]))
        && (u.size() < 2 || validManager(m[u[1]]))
        && (u.size() < 3 || validManager(m[u[2]]));
    }
    function isManagerOf(b) {
      return signedIn() && request.auth.uid in b.get('managerUids', []);
    }
    function managerCan(b, perm) {
      return isManagerOf(b) && b.managers[request.auth.uid][perm] == true;
    }
    function businessFollowPath(bid, uid) {
      return /databases/$(database)/documents/businessFollows/$(bid + '_' + uid);
    }

    // Ara (PROJE.md 5.10): addan / yazıdan üretilen arama anahtarları (kelime başları), yalnızca sayısı sınırlanır.
    function validSearchKeys(d, max) {
      return !('searchKeys' in d) || (d.searchKeys is list && d.searchKeys.size() <= max);
    }

    function businessContentKeys() {
      return ['type', 'name', 'categoryIds', 'location', 'address', 'phone', 'whatsapp', 'is24h', 'hoursNote',
              'description', 'priceList', 'searchKeys', 'weeklyHours', 'paymentMethods', 'amenities', 'roadside', 'geo'];
    }

    function businessPath(id) {
      return /databases/$(database)/documents/businesses/$(id);
    }

    function phoneClaimedBy(phone, id) {
      return existsAfter(/databases/$(database)/documents/businessPhones/$(phone))
        && getAfter(/databases/$(database)/documents/businessPhones/$(phone)).data.businessId == id;
    }

    function myReviewPath(bid) {
      return /databases/$(database)/documents/businesses/$(bid)/reviews/$(request.auth.uid);
    }

    // Yayındaki değerlendirmenin yıldızı ve sayısı (gizlenen sayılmaz), yazımdan önce ve sonra.
    function starsBefore(bid) {
      return exists(myReviewPath(bid)) && get(myReviewPath(bid)).data.status == 'yayinda' ? get(myReviewPath(bid)).data.stars : 0;
    }
    function countBefore(bid) {
      return exists(myReviewPath(bid)) && get(myReviewPath(bid)).data.status == 'yayinda' ? 1 : 0;
    }
    function starsAfter(bid) {
      return existsAfter(myReviewPath(bid)) && getAfter(myReviewPath(bid)).data.status == 'yayinda' ? getAfter(myReviewPath(bid)).data.stars : 0;
    }
    function countAfter(bid) {
      return existsAfter(myReviewPath(bid)) && getAfter(myReviewPath(bid)).data.status == 'yayinda' ? 1 : 0;
    }

    function ratingChangeValid(bid) {
      return request.resource.data.rating.keys().hasOnly(['sum', 'count'])
        && request.resource.data.rating.sum == resource.data.rating.sum - starsBefore(bid) + starsAfter(bid)
        && request.resource.data.rating.count == resource.data.rating.count - countBefore(bid) + countAfter(bid);
    }

    match /businesses/{id} {
      // Olmayan belgeyi okumak ("var mı?" sorusu) reddedilmez; içerik yoksa sızacak bilgi de yoktur.
      // İşletme doğrulama yetkisi olan yönetici kendi ilindeki gizli / kaldırılmış işletmeleri de görür.
      allow read: if resource == null || resource.data.status == 'yayinda' || isSelf(resource.data.ownerUid)
        || isManagerOf(resource.data)
        || regionAllows('isletme-dogrulama', 'goruntule', resource.data.location.provinceCode, null);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(businessContentKeys().concat(
             ['ownerUid', 'status', 'verification', 'membership', 'rating', 'createdAt', 'updatedAt']))
        && validBusinessContent(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'yayinda'
        && request.resource.data.verification == {'status': 'dogrulanmadi'}
        && request.resource.data.membership == {'tier': 'ucretsiz'}
        && request.resource.data.rating == {'sum': 0, 'count': 0}
        // Aynı telefonla ikinci işletme açılamaz: telefon kaydı aynı toplu yazımda bu işletmeye bağlanır.
        && phoneClaimedBy(request.resource.data.phone, id)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Sahibi: kendi bilgileri, gizle/yayınla ve yetkililer. Yönetimin kaldırdığı işletmeyi açamaz.
      allow update: if isSelf(resource.data.ownerUid)
        && resource.data.status != 'kaldirildi'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(businessContentKeys().concat(['status', 'updatedAt', 'managers', 'managerUids']))
        && validBusinessContent(request.resource.data)
        && validManagers(request.resource.data)
        && request.resource.data.status in ['yayinda', 'gizli']
        && (request.resource.data.phone == resource.data.phone || phoneClaimedBy(request.resource.data.phone, id))
        && request.resource.data.updatedAt == request.time;
      // Düzenleme izni olan yetkili: bilgiler (telefon sahibine bağlı, değişmez).
      allow update: if managerCan(resource.data, 'edit')
        && resource.data.status != 'kaldirildi'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(businessContentKeys().concat(['updatedAt']))
        && request.resource.data.phone == resource.data.phone
        && validBusinessContent(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      // Yetkili kendini çıkarır (yalnızca kendisi; diğerleri ve izinleri aynı kalır).
      allow update: if isManagerOf(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managers', 'managerUids', 'updatedAt'])
        && !(request.auth.uid in request.resource.data.managerUids)
        && request.resource.data.managerUids.size() == resource.data.managerUids.size() - 1
        && request.resource.data.managers.diff(resource.data.managers).affectedKeys().hasOnly([request.auth.uid])
        && validManagers(request.resource.data);
      // Takip sayacı: yalnızca kendi takip kaydıyla tam bir artar ya da azalır.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
        && ((request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
              && !exists(businessFollowPath(id, request.auth.uid)) && existsAfter(businessFollowPath(id, request.auth.uid)))
            || (request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1
              && exists(businessFollowPath(id, request.auth.uid)) && !existsAfter(businessFollowPath(id, request.auth.uid))));
      // Değerlendirme yazan kişi: yalnızca yıldız toplamı, tam olarak kendi değerlendirmesi kadar değişir.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
        && ratingChangeValid(id);
      // Yönetim (admin): doğrulama, kaldırma, kademe, öne çıkma, yetkili çıkarma. İşletmenin bilgilerini değiştiremez.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verification', 'membership', 'featuredUntil', 'rating', 'managers', 'managerUids'])
        && validManagers(request.resource.data)
        && request.resource.data.get('managerUids', []).size() <= resource.data.get('managerUids', []).size()
        && request.resource.data.status in ['yayinda', 'gizli', 'kaldirildi']
        && request.resource.data.verification.status in ['dogrulanmadi', 'inceleniyor', 'dogrulandi']
        && request.resource.data.membership.tier in ['ucretsiz', 'standart', 'pro', 'premium'];
      // Sahibi silebilir (hesap silmede de kullanılır, KVKK).
      allow delete: if isSelf(resource.data.ownerUid);
    }

    // İşletme takibi (belge kimliği = işletme_kişi). Kişi yalnızca kendi takiplerini görür; sayaç aynı yazımda değişir.
    match /businessFollows/{fid} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'businessId', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && fid == request.resource.data.businessId + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time
        && get(businessPath(request.resource.data.businessId)).data.status == 'yayinda'
        && getAfter(businessPath(request.resource.data.businessId)).data.followerCount
             == get(businessPath(request.resource.data.businessId)).data.get('followerCount', 0) + 1;
      // İşletme silinmişse (ya da sayaç birlikte azalıyorsa) takip kaydı silinir.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(businessPath(resource.data.businessId))
            || getAfter(businessPath(resource.data.businessId)).data.followerCount
                 == get(businessPath(resource.data.businessId)).data.get('followerCount', 0) - 1);
      allow update: if false;
    }

    // Telefon kaydı: bir telefon tek işletmeye bağlıdır. Kart zaten telefonu gösterdiği için okunabilir (tekil).
    match /businessPhones/{phone} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['businessId', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && existsAfter(businessPath(request.resource.data.businessId))
        && getAfter(businessPath(request.resource.data.businessId)).data.ownerUid == request.auth.uid
        && getAfter(businessPath(request.resource.data.businessId)).data.phone == phone;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid
        && (!existsAfter(businessPath(resource.data.businessId))
            || getAfter(businessPath(resource.data.businessId)).data.phone != phone);
      allow update: if false;
    }

    // Uygulamadan arama / WhatsApp kaydı: değerlendirme yazabilmenin şartı. Yalnızca sahibi görür.
    match /contacts/{id} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'businessId', 'at'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.businessId + '_' + request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if false;
    }

    // İşletme değerlendirmeleri (belge kimliği = yazanın kimliği: kişi başına bir değerlendirme).
    match /businesses/{bid}/reviews/{uid} {
      function biz() {
        return get(businessPath(bid)).data;
      }
      function validReview(d) {
        return d.stars is int && d.stars >= 1 && d.stars <= 5
          && d.text is string && d.text.size() >= 10 && d.text.size() <= 500;
      }
      function ratingWrittenTogether() {
        return existsAfter(businessPath(bid)) && getAfter(businessPath(bid)).data.rating != biz().rating;
      }

      allow read: if resource == null || resource.data.status == 'yayinda' || isSelf(uid) || isAdmin()
        || (signedIn() && biz().ownerUid == request.auth.uid);
      allow create: if isSelf(uid)
        && biz().status == 'yayinda' && biz().ownerUid != uid
        && exists(/databases/$(database)/documents/contacts/$(bid + '_' + uid))
        && request.resource.data.keys().hasOnly(['uid', 'stars', 'text', 'authorName', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && validReview(request.resource.data)
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 40
        && request.resource.data.status == 'yayinda'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && ratingWrittenTogether();
      // Yazan: yıldız ve metni değiştirir (gizlenen yorumu değiştiremez); puan toplamı birlikte güncellenir.
      allow update: if isSelf(uid) && resource.data.status == 'yayinda'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stars', 'text', 'updatedAt'])
        && validReview(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.stars == resource.data.stars || ratingWrittenTogether());
      // İşletme sahibinin (ya da cevap izni olan yetkilinin) cevabı.
      allow update: if signedIn() && (biz().ownerUid == request.auth.uid || managerCan(biz(), 'reply'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
        && request.resource.data.reply.keys().hasOnly(['text', 'at'])
        && request.resource.data.reply.text is string
        && request.resource.data.reply.text.size() >= 2 && request.resource.data.reply.text.size() <= 500
        && request.resource.data.reply.at == request.time;
      // Yönetim: gizle / geri aç (puan aynı işlemde düzeltilir).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.status in ['yayinda', 'gizlendi'];
      // Yazan siler (yayındaysa puan birlikte düşer); işletme silinirken sahibi tüm yorumları siler.
      allow delete: if (isSelf(uid)
            && (!exists(businessPath(bid)) || resource.data.status != 'yayinda' || !existsAfter(businessPath(bid))
                || getAfter(businessPath(bid)).data.rating.count == biz().rating.count - 1))
        || (signedIn() && exists(businessPath(bid)) && biz().ownerUid == request.auth.uid && !existsAfter(businessPath(bid)));
    }

    // Hesap silmede kullanıcının tüm değerlendirmelerini bulmak için (yalnızca kendi yorumları).
    match /{path=**}/reviews/{rid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Değerlendirme şikâyetleri: kişi başına yorum başına bir şikâyet; admin inceler.
    match /reviewReports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['businessId', 'reviewUid', 'reporterUid', 'reason', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reviewUid != request.auth.uid
        && id == request.resource.data.businessId + '_' + request.resource.data.reviewUid + '_' + request.auth.uid
        && request.resource.data.reason in ['hakaret', 'sahte', 'kisisel-veri', 'alakasiz', 'diger']
        && request.resource.data.status == 'yeni'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'incelendi';
      allow delete: if false;
    }

    // ---- SOS - Aileme haber ver (PROJE.md 5.4) ----
    function familyLinkPath(a, b) {
      return /databases/$(database)/documents/familyLinks/$(a < b ? a + '_' + b : b + '_' + a);
    }
    function isFamily(other) {
      return exists(familyLinkPath(request.auth.uid, other));
    }
    // Alıcıların hepsi gönderenin aile listesinde olmalı (en çok 10 kişi; kurallar döngü kuramadığı için tek tek).
    function recipientOk(r, i) {
      return r.size() <= i || (r[i] is string && r[i] != request.auth.uid && isFamily(r[i]));
    }
    function recipientsAreFamily(r) {
      return r is list && r.size() >= 1 && r.size() <= 10
        && recipientOk(r, 0) && recipientOk(r, 1) && recipientOk(r, 2) && recipientOk(r, 3) && recipientOk(r, 4)
        && recipientOk(r, 5) && recipientOk(r, 6) && recipientOk(r, 7) && recipientOk(r, 8) && recipientOk(r, 9);
    }
    function validSosLocation(l) {
      return l is map && l.keys().hasOnly(['lat', 'lng', 'accuracy', 'at'])
        && l.lat is number && l.lat >= -90 && l.lat <= 90 && l.lng is number && l.lng >= -180 && l.lng <= 180
        && (!('accuracy' in l) || l.accuracy is number)
        && l.at == request.time;
    }

    // Davet kodu: tek kullanımlık, 24 saat. Kod gizli anahtar gibidir; tekil okunur, listelenmez (yalnızca sahibi).
    match /familyInvites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow create: if signedIn()
        && code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'createdAt', 'expiresAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
      // Kabul: başkası, süresi dolmadan, bir kez; aile bağı aynı toplu yazımda kurulur.
      allow update: if signedIn()
        && request.auth.uid != resource.data.fromUid
        && !('usedBy' in resource.data)
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(familyLinkPath(request.auth.uid, resource.data.fromUid));
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Aile bağı (iki kişi, karşılıklı). Yalnızca iki taraf görür; her biri istediği an siler (ayrılır).
    match /familyLinks/{id} {
      function inviteAfter() {
        return getAfter(/databases/$(database)/documents/familyInvites/$(request.resource.data.inviteCode)).data;
      }
      function inviteBefore() {
        return get(/databases/$(database)/documents/familyInvites/$(request.resource.data.inviteCode)).data;
      }
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'inviteCode', 'createdAt'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.names is map && request.resource.data.names.keys().hasOnly(request.resource.data.members)
        && request.resource.data.createdAt == request.time
        // Davet geçerli: karşı tarafın daveti, kullanılmamış, süresi dolmamış; bu yazımda bana kullanıldı.
        && !('usedBy' in inviteBefore())
        && request.time < inviteBefore().expiresAt
        && inviteBefore().fromUid in request.resource.data.members
        && inviteBefore().fromUid != request.auth.uid
        && inviteAfter().usedBy == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // SOS kaydı: yalnızca gönderen ve alıcılar görür; panel/admin göremez (gizlilik).
    match /sosAlerts/{id} {
      allow read: if signedIn() && (resource == null || resource.data.fromUid == request.auth.uid
        || request.auth.uid in resource.data.recipients);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'recipients', 'test', 'status', 'location',
             'createdAt', 'liveUntil', 'deleteAt', 'deliveredTo', 'seenBy'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && recipientsAreFamily(request.resource.data.recipients)
        && request.resource.data.test is bool
        && request.resource.data.status == 'aktif'
        && (!('location' in request.resource.data) || validSosLocation(request.resource.data.location))
        && request.resource.data.createdAt == request.time
        && request.resource.data.liveUntil is timestamp
        && request.resource.data.liveUntil <= request.time + duration.value(121, 'm')
        && request.resource.data.deleteAt is timestamp
        && request.resource.data.deliveredTo == {} && request.resource.data.seenBy == {};
      // Gönderen: canlı konum ve durum (Güvendeyim / Yardım gerek / bitir).
      allow update: if signedIn() && resource.data.fromUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['location', 'status'])
        && request.resource.data.status in ['aktif', 'guvende', 'bitti']
        && (!('location' in request.resource.data.diff(resource.data).affectedKeys()) || validSosLocation(request.resource.data.location));
      // Alıcı: yalnızca kendi "teslim edildi" ve "görüldü" işareti.
      allow update: if signedIn() && request.auth.uid in resource.data.recipients
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredTo', 'seenBy'])
        && request.resource.data.deliveredTo.diff(resource.data.deliveredTo).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.seenBy.diff(resource.data.seenBy).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Bildirim adresleri (telefon başına, en çok 5): SOS bildirimini aile üyesinin telefonu gönderir.
    // Yalnızca sahibi ve aile üyeleri okur (yabancı bildirim gönderemesin diye).
    match /pushTokens/{uid} {
      allow read: if isSelf(uid) || (signedIn() && isFamily(uid));
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'language', 'updatedAt'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 5
        && request.resource.data.language in ['tr', 'en', 'de', 'ar', 'ru']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Bildirim kategorileri haritası (tercihler ve panel tetikleyicileri): bilinen kategoriler, hepsi evet/hayır.
    function validNotificationMap(m) {
      return m is map && m.keys().hasOnly(['acil', 'sos', 'mesaj', 'takip', 'duyuru', 'haber', 'etkinlik'])
        && m.keys().hasAll(['acil', 'sos', 'mesaj', 'takip', 'duyuru', 'haber', 'etkinlik'])
        && m.acil is bool && m.sos is bool && m.mesaj is bool && m.takip is bool && m.duyuru is bool && m.haber is bool && m.etkinlik is bool;
    }

    // Önerilen aramalar listesi (dil başına en çok 12, her biri en çok 40 harf; uzunluğu panel denetler).
    function termList(t, k) {
      return !(k in t) || (t[k] is list && t[k].size() <= 12);
    }

    function fuelPrice(f, k) {
      return !(k in f) || (f[k] is number && f[k] >= 1 && f[k] <= 500);
    }

    // Uygulama ayarları (SOS süreleri): herkes okur, admin yazar.
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'sos'
        && request.resource.data.keys().hasOnly(['liveMinutes', 'countdownSeconds', 'updatedBy', 'updatedAt'])
        && request.resource.data.liveMinutes is int && request.resource.data.liveMinutes >= 10 && request.resource.data.liveMinutes <= 120
        && request.resource.data.countdownSeconds is int && request.resource.data.countdownSeconds >= 3 && request.resource.data.countdownSeconds <= 10
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      // Seyahat > Planla tahmini ücretleri: akaryakıt (TL/litre, elektrikte TL/kWh) ve otobüs km ücreti; admin girer.
      allow write: if isAdmin() && id == 'travelPrices'
        && request.resource.data.keys().hasOnly(['fuel', 'busPerKm', 'month', 'updatedBy', 'updatedAt'])
        && request.resource.data.fuel is map && request.resource.data.fuel.keys().hasOnly(['benzin', 'dizel', 'lpg', 'elektrik'])
        && fuelPrice(request.resource.data.fuel, 'benzin') && fuelPrice(request.resource.data.fuel, 'dizel')
        && fuelPrice(request.resource.data.fuel, 'lpg') && fuelPrice(request.resource.data.fuel, 'elektrik')
        && (!('busPerKm' in request.resource.data) || (request.resource.data.busPerKm is map
              && request.resource.data.busPerKm.keys().hasOnly(['min', 'max'])
              && request.resource.data.busPerKm.min is number && request.resource.data.busPerKm.min >= 0.1
              && request.resource.data.busPerKm.max is number && request.resource.data.busPerKm.max <= 20
              && request.resource.data.busPerKm.min <= request.resource.data.busPerKm.max))
        && request.resource.data.month is string && request.resource.data.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      // Keşfet yasaklı kelime listesi (madde 8): admin yönetir, uygulama okur.
      allow write: if isAdmin() && id == 'bannedWords'
        && request.resource.data.keys().hasOnly(['words', 'updatedBy', 'updatedAt'])
        && request.resource.data.words is list && request.resource.data.words.size() <= 1000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      // Ara: önerilen aramalar (PROJE.md 5.10), dil başına en çok 12; admin yönetir, uygulama okur.
      allow write: if isAdmin() && id == 'searchSuggestions'
        && request.resource.data.keys().hasOnly(['terms', 'updatedBy', 'updatedAt'])
        && request.resource.data.terms is map && request.resource.data.terms.keys().hasOnly(['tr', 'en', 'de', 'ar', 'ru'])
        && termList(request.resource.data.terms, 'tr') && termList(request.resource.data.terms, 'en')
        && termList(request.resource.data.terms, 'de') && termList(request.resource.data.terms, 'ar')
        && termList(request.resource.data.terms, 'ru')
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      // Ana sayfadaki tanıtım videosu bağlantısı (13. madde 29): admin yönetir; boş ya da https bağlantısı.
      allow write: if isAdmin() && id == 'introVideo'
        && request.resource.data.keys().hasOnly(['url', 'updatedBy', 'updatedAt'])
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('https://[^ ]+'))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      // Bildirim tetikleyicileri (PROJE.md 7): admin yönetir; acil duyuru ve SOS kapatılamaz.
      allow write: if isAdmin() && id == 'notificationTriggers'
        && request.resource.data.keys().hasOnly(['triggers', 'updatedBy', 'updatedAt'])
        && validNotificationMap(request.resource.data.triggers)
        && request.resource.data.triggers.acil == true && request.resource.data.triggers.sos == true
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // ---- Yetkiler (PROJE.md 6.7): admin il yöneticisi, muhtar ve moderatör verir; il yöneticisi kendi ilinde muhtar
    // ve moderatör verir, kendinde olmayan yetkiyi veremez. Admin rolü panelden verilmez (yalnızca konsol, admins).
    // Rol sınırları ortak paketteki ROLE_CAPS ile aynıdır.
    function capsFor(role) {
      return role == 'il-yoneticisi' ? {
          'konumlar': ['goruntule'], 'acil-numaralar': ['goruntule'], 'hizmet-kategorileri': ['goruntule', 'onayla'],
          'kurumlar': ['goruntule'], 'yetkiler': ['goruntule', 'ekle', 'duzenle', 'sil'], 'onaylar': ['goruntule', 'onayla'],
          'islem-kayitlari': ['goruntule'], 'bildirimler': ['goruntule', 'ekle', 'duzenle', 'sil', 'yayinla', 'bildirim-gonder'],
          'gonderiler': ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla', 'yayinla'],
          'etkinlikler': ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla', 'yayinla'],
          'hizmetler': ['goruntule', 'ekle', 'duzenle', 'sil'], 'moderasyon': ['goruntule', 'duzenle', 'sil'],
          'isletme-dogrulama': ['goruntule', 'onayla'], 'sehir-rehberi': ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla']}
        : role == 'muhtar' ? {
          'konumlar': ['goruntule'], 'islem-kayitlari': ['goruntule'], 'gonderiler': ['goruntule', 'ekle', 'duzenle', 'sil', 'yayinla'],
          'etkinlikler': ['goruntule', 'ekle', 'duzenle', 'yayinla'], 'bildirimler': ['goruntule', 'ekle', 'yayinla', 'bildirim-gonder']}
        : {'konumlar': ['goruntule'], 'islem-kayitlari': ['goruntule'], 'moderasyon': ['goruntule', 'duzenle']};
    }
    function within(m, caps, k) {
      return !(k in m) || (m[k] is list && m[k].size() >= 1 && m[k].hasOnly(caps.get(k, [])));
    }
    // Muhtar ve moderatör yetkisinin bölümleri (kuralların hesap sınırı için yalnızca bunlar denetlenir).
    function muhtarWithin(m, caps) {
      return within(m, caps, 'konumlar') && within(m, caps, 'islem-kayitlari') && within(m, caps, 'gonderiler')
        && within(m, caps, 'etkinlikler') && within(m, caps, 'bildirimler');
    }
    function moderatorWithin(m, caps) {
      return within(m, caps, 'konumlar') && within(m, caps, 'islem-kayitlari') && within(m, caps, 'moderasyon');
    }
    // Rolün bölümleri ve eylemleri verilen sınırın içinde mi (rol sınırı ya da verenin kendi yetkisi)?
    function roleModulesWithin(m, role, caps) {
      return m is map && m.size() >= 1 && m.keys().hasOnly(capsFor(role).keys())
        && (role == 'muhtar' ? muhtarWithin(m, caps)
            : role == 'moderator' ? moderatorWithin(m, caps)
            : modulesWithin(m, caps));
    }
    function modulesWithin(m, caps) {
      return m is map && m.size() >= 1 && m.keys().hasOnly(caps.keys())
        && within(m, caps, 'konumlar') && within(m, caps, 'meslekler') && within(m, caps, 'acil-numaralar')
        && within(m, caps, 'hizmet-kategorileri') && within(m, caps, 'sos') && within(m, caps, 'kurumlar')
        && within(m, caps, 'yetkiler') && within(m, caps, 'onaylar') && within(m, caps, 'islem-kayitlari')
        && within(m, caps, 'bildirimler') && within(m, caps, 'gonderiler') && within(m, caps, 'etkinlikler')
        && within(m, caps, 'hizmetler') && within(m, caps, 'moderasyon') && within(m, caps, 'isletme-dogrulama')
        && within(m, caps, 'sehir-rehberi');
    }
    function validScope(sc) {
      return sc is map && (
        (sc.level == 'ulke' && sc.keys().hasOnly(['level']))
        || (sc.level == 'il' && sc.keys().hasOnly(['level', 'provinceCode'])
            && sc.provinceCode is string && sc.provinceCode.matches('^[0-8][0-9]$'))
        || (sc.level == 'ilce' && sc.keys().hasOnly(['level', 'provinceCode', 'districtId'])
            && sc.provinceCode is string && sc.provinceCode.matches('^[0-8][0-9]$')
            && sc.districtId is string && sc.districtId.matches('^' + sc.provinceCode + '-[a-z0-9-]+$'))
        || (sc.level == 'mahalle' && sc.keys().hasOnly(['level', 'provinceCode', 'districtId', 'neighbourhoodId'])
            && sc.provinceCode is string && sc.provinceCode.matches('^[0-8][0-9]$')
            && sc.districtId is string && sc.districtId.matches('^' + sc.provinceCode + '-[a-z0-9-]+$')
            && sc.neighbourhoodId is string && sc.neighbourhoodId.matches('^' + sc.districtId + '-.+$')));
    }
    function scopeKeyOf(sc) {
      return sc.level == 'ulke' ? 'ulke'
        : sc.level == 'il' ? 'il-' + sc.provinceCode
        : sc.level == 'ilce' ? 'ilce-' + sc.districtId
        : 'mahalle-' + sc.neighbourhoodId;
    }
    function roleFitsScope(role, level) {
      return (role == 'il-yoneticisi' && level == 'il')
        || (role == 'muhtar' && level == 'mahalle')
        || (role == 'moderator' && level in ['il', 'ilce', 'mahalle']);
    }
    function validEmail(e) {
      return e is string && e.size() <= 120 && e.matches('^[^@ A-Z]+@[^@ A-Z]+[.][^@ A-Z]+$');
    }
    function validGrant(id, d) {
      return d.keys().hasOnly(['email', 'displayName', 'note', 'role', 'scope', 'modules', 'expiresAt',
             'grantedBy', 'grantedAt', 'updatedAt', 'revokedAt', 'revokedBy'])
        && validEmail(d.email)
        // Kimse kendine yetki veremez.
        && d.email != request.auth.token.get('email', '')
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 80
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && validScope(d.scope)
        && roleFitsScope(d.role, d.scope.level)
        && id == d.email + '__' + scopeKeyOf(d.scope)
        && roleModulesWithin(d.modules, d.role, capsFor(d.role))
        && (!('expiresAt' in d) || d.expiresAt is timestamp)
        && d.grantedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    // Bu ilde il yöneticisiyim ve bu eylemde yetki yönetebilirim.
    function provinceManager(provinceCode, action) {
      return grantAllows('il-' + provinceCode, 'yetkiler', action)
        && get(grantPath('il-' + provinceCode)).data.role == 'il-yoneticisi';
    }
    function canGrant(d) {
      return isAdmin()
        || (d.role in ['muhtar', 'moderator'] && d.scope.level != 'ulke'
            && provinceManager(d.scope.provinceCode, 'ekle')
            // Kimse kendinde olmayan yetkiyi veremez.
            && (d.role == 'muhtar' ? muhtarWithin(d.modules, get(grantPath('il-' + d.scope.provinceCode)).data.modules)
                : moderatorWithin(d.modules, get(grantPath('il-' + d.scope.provinceCode)).data.modules)));
    }

    match /grants/{id} {
      // Kişi kendi yetkilerini görür (panel menüsü bundan kurulur); il yöneticisi kendi ilindekileri; admin hepsini.
      allow read: if isAdmin()
        || (verified() && (resource == null || resource.data.email == myEmail()))
        || provinceManager(resource.data.scope.provinceCode, 'goruntule');
      // Verme / değiştirme / yeniden verme: belgenin tamamı yazılır, geri alma bilgisi temizlenir. İl yöneticisi başka
      // bir il yöneticisinin yetkisinin üstüne yazamaz.
      // (Ucuz denetimler önce: kuralların hesap sınırı aşılmasın.)
      allow create, update: if !('revokedAt' in request.resource.data) && !('revokedBy' in request.resource.data)
        && request.resource.data.grantedAt == request.time
        && validGrant(id, request.resource.data)
        && canGrant(request.resource.data)
        && (resource == null || isAdmin() || resource.data.role in ['muhtar', 'moderator']);
      // Geri alma: yalnızca geri alma bilgisi eklenir, yetkinin içeriği değişmez.
      allow update: if resource.data.get('revokedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt', 'revokedBy', 'updatedAt'])
        && request.resource.data.revokedAt == request.time
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (isAdmin()
            || (resource.data.role in ['muhtar', 'moderator'] && resource.data.scope.level != 'ulke'
                && provinceManager(resource.data.scope.provinceCode, 'sil')));
      // Silinmez: geçmiş yetkiler denetim için kalır.
      allow delete: if false;
    }

    // ---- Kurumlar (PROJE.md 6.6-6.7): yalnızca admin açar. Kurum yöneticisi kendi personeline, kurumun bölgesi ve
    // bölümleri içinde görev verir; yeni kurum yöneticisini admin atar. Pasif ya da sözleşmesi biten kurumda kimse çalışamaz.
    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }
    function memberPath(orgId) {
      return /databases/$(database)/documents/orgMembers/$(orgId + '__' + myEmail());
    }
    function memberActive(m) {
      return m.get('removedAt', null) == null && (m.get('expiresAt', null) == null || m.expiresAt > request.time);
    }
    function orgActive(o) {
      return o.status == 'aktif' && (o.get('contractEndsAt', null) == null || o.contractEndsAt > request.time);
    }
    function isMemberOf(orgId) {
      return verified() && exists(memberPath(orgId)) && memberActive(get(memberPath(orgId)).data)
        && exists(orgPath(orgId)) && orgActive(get(orgPath(orgId)).data);
    }
    function isOrgAdminOf(orgId) {
      return isMemberOf(orgId) && get(memberPath(orgId)).data.isOrgAdmin == true;
    }
    function validOrg(id, d) {
      return d.keys().hasOnly(['name', 'kind', 'scope', 'modules', 'officialEmail', 'status', 'contractEndsAt',
             'createdBy', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.kind in ['buyuksehir-belediyesi', 'il-belediyesi', 'ilce-belediyesi', 'kurum', 'kulup', 'yayinci']
        // Belediyeler kilitli ad listesindeki kimlikle açılır (aynı belediye iki kez açılamaz).
        && (d.kind in ['buyuksehir-belediyesi', 'il-belediyesi', 'ilce-belediyesi']) == id.matches('^bld-[0-9]{2}(-[a-z0-9-]+)?$')
        && (id.matches('^bld-.+') || id.matches('^krm-[a-z0-9-]{2,80}$'))
        && validScope(d.scope)
        && d.modules is list && d.modules.hasOnly(['gonderiler', 'etkinlikler', 'bildirimler', 'hizmetler', 'seyahat'])
        // Seyahat (Başkanlarla Keşif) yalnızca belediyelere.
        && (!d.modules.hasAny(['seyahat']) || d.kind in ['buyuksehir-belediyesi', 'il-belediyesi', 'ilce-belediyesi'])
        && validEmail(d.officialEmail)
        && d.status in ['aktif', 'pasif']
        && (!('contractEndsAt' in d) || d.contractEndsAt is timestamp)
        && d.updatedAt == request.time;
    }

    match /organizations/{id} {
      allow read: if isAdmin() || isMemberOf(id)
        || grantAllows('il-' + resource.data.scope.provinceCode, 'kurumlar', 'goruntule');
      allow create: if isAdmin() && validOrg(id, request.resource.data)
        && request.resource.data.status == 'aktif'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validOrg(id, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'modules', 'contractEndsAt', 'updatedAt']);
      allow delete: if false;
    }

    // Görev: bölüm başına işaretlenen eylemler (Karar, Eren, 27 Ekim 2026). "Bildirim gönder" yalnızca bildirimlerde.
    function validAssignment(a, k) {
      return !(k in a) || (a[k] is list && a[k].size() >= 1
        && a[k].hasOnly(k == 'bildirimler'
            ? ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla', 'yayinla', 'bildirim-gonder']
            : ['goruntule', 'ekle', 'duzenle', 'sil', 'onayla', 'yayinla']));
    }
    function validMember(id, d) {
      return d.keys().hasOnly(['orgId', 'email', 'displayName', 'isOrgAdmin', 'assignments', 'expiresAt', 'addedBy', 'updatedAt'])
        // Kurum aynı toplu yazımda açılıyor olabilir (kurum + kurum yöneticisi), bu yüzden yazım sonrası durum okunur.
        && d.orgId is string && existsAfter(orgPath(d.orgId))
        && validEmail(d.email)
        && id == d.orgId + '__' + d.email
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 80
        && d.isOrgAdmin is bool
        && d.assignments is map && d.assignments.keys().hasOnly(getAfter(orgPath(d.orgId)).data.modules)
        && validAssignment(d.assignments, 'gonderiler') && validAssignment(d.assignments, 'etkinlikler')
        && validAssignment(d.assignments, 'bildirimler') && validAssignment(d.assignments, 'hizmetler')
        && validAssignment(d.assignments, 'seyahat')
        && (!('expiresAt' in d) || d.expiresAt is timestamp)
        && d.addedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /orgMembers/{id} {
      // Kişi kendi görevlerini, kurum yöneticisi kendi kurumunun personelini, admin hepsini görür.
      allow read: if isAdmin()
        || (verified() && (resource == null || resource.data.email == myEmail()))
        || isOrgAdminOf(resource.data.orgId);
      // Ekleme / görev değiştirme / yeniden ekleme. Kurum yöneticisi kendi kaydını ve başka bir kurum yöneticisini
      // değiştiremez, kurum yöneticisi atayamaz.
      allow create, update: if validMember(id, request.resource.data)
        && (isAdmin()
            || (isOrgAdminOf(request.resource.data.orgId)
                && request.resource.data.isOrgAdmin == false
                && request.resource.data.email != myEmail()
                && (resource == null || resource.data.isOrgAdmin == false)));
      // Çıkarma: yalnızca çıkarma bilgisi eklenir.
      allow update: if (isAdmin() || (isOrgAdminOf(resource.data.orgId) && resource.data.isOrgAdmin == false))
        && resource.data.get('removedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removedAt', 'removedBy', 'updatedAt'])
        && request.resource.data.removedAt == request.time
        && request.resource.data.removedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---- Benim Şehrim sabit bilgileri (müzeler, otoparklar...): il başına bölüm paketleri. Herkes okur (girişsiz de);
    // admin ve o ilde şehir rehberi yetkisi olan (il yöneticisi) yazar. Ülke geneli içerik ("tr") yalnızca admin'de.
    function canEditGuide(p) {
      return isAdmin() || (p is string && p != 'tr' && regionAllows('sehir-rehberi', 'duzenle', p, null));
    }
    function guideSection(s) {
      return s in ['onemli-kurumlar', 'muzeler', 'otoparklar', 'parklar', 'pazarlar', 'ulasim', 'toplanma-alanlari',
                   'muhtarliklar', 'belediye-hizmetleri', 'nasil-yapilir'];
    }
    match /cityGuide/{p} {
      allow read: if true;
      allow create, update: if (p == 'tr' || p.matches('^[0-8][0-9]$')) && canEditGuide(p)
        && request.resource.data.keys().hasOnly(['sections', 'updatedAt', 'updatedBy'])
        && request.resource.data.sections is map && request.resource.data.sections.keys().size() <= 10
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Şehir Vitrini (haftalık seçki): yayındakini herkes okur; o ilin şehir rehberi yetkisi olan (admin, il yöneticisi) yazar.
    function validShowcase(d) {
      return d.keys().hasOnly(['provinceCode', 'issue', 'title', 'intro', 'weekOf', 'stories', 'status', 'updatedAt'])
        && d.provinceCode is string && d.provinceCode.matches('^[0-8][0-9]$')
        && d.issue is int && d.issue >= 1 && d.issue <= 10000
        && d.title is string && d.title.size() >= 2 && d.title.size() <= 80
        && d.intro is string && d.intro.size() <= 400
        && d.weekOf is string && d.weekOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.stories is list && d.stories.size() >= 1 && d.stories.size() <= 8
        && d.status in ['taslak', 'yayinda']
        && d.updatedAt == request.time;
    }
    match /cityShowcases/{id} {
      allow read: if resource == null || resource.data.status == 'yayinda' || canEditGuide(resource.data.provinceCode);
      allow create, update: if validShowcase(request.resource.data) && canEditGuide(request.resource.data.provinceCode)
        && (resource == null || resource.data.provinceCode == request.resource.data.provinceCode);
      allow delete: if canEditGuide(resource.data.provinceCode);
    }
    // Yoldayım: OpenStreetMap'ten hazırlanan yol üstü yerler (akaryakıt, şarj, dinlenme tesisi), 3 harflik geohash
    // hücresi başına bir paket. Herkes okur (girişsiz de); yalnızca admin yükler.
    match /roadsidePacks/{cell} {
      allow read: if true;
      allow create, update: if isAdmin() && cell.matches('^[0-9b-hjkmnp-z]{3}$')
        && request.resource.data.keys().hasOnly(['cell', 'items', 'count', 'source', 'updatedAt', 'updatedBy'])
        && request.resource.data.cell == cell
        && request.resource.data.items is list && request.resource.data.items.size() <= 2500
        && request.resource.data.count == request.resource.data.items.size()
        && request.resource.data.source == 'osm'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /cityGuidePacks/{id} {
      allow read: if true;
      allow create, update: if canEditGuide(request.resource.data.provinceCode)
        && request.resource.data.keys().hasOnly(['provinceCode', 'section', 'part', 'items', 'updatedAt', 'updatedBy'])
        && guideSection(request.resource.data.section)
        && request.resource.data.part is int && request.resource.data.part >= 0 && request.resource.data.part < 50
        && id == request.resource.data.provinceCode + '__' + request.resource.data.section + '__' + string(request.resource.data.part)
        && request.resource.data.items is list && request.resource.data.items.size() <= 400
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if canEditGuide(resource.data.provinceCode);
    }

    // ---- Onay merkezi (PROJE.md 6.5, 6.7): onay gereken iş önce il yöneticisinin (1. aşama), sonra admin'in onayından
    // geçer. approvals/{tür}__{hedef}: aynı iş için tek istek. Şimdilik yalnızca işletme doğrulaması açık.
    function validApproval(id, d) {
      return d.keys().hasOnly(['kind', 'module', 'targetId', 'title', 'region', 'status', 'requestedBy', 'requestedAt',
             'note', 'firstApproval', 'decision', 'updatedAt'])
        && d.kind == 'isletme-dogrulama' && d.module == 'isletme-dogrulama'
        && d.targetId is string && id == d.kind + '__' + d.targetId
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && validLocation(d.region) && 'districtId' in d.region && !('neighbourhoodId' in d.region)
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && d.requestedAt == request.time
        && d.updatedAt == request.time;
    }
    // Hedef işletme var, adı ve yeri istekteki gibi, henüz doğrulanmamış.
    function businessTargetOk(d) {
      return exists(businessPath(d.targetId))
        && get(businessPath(d.targetId)).data.name == d.title
        && get(businessPath(d.targetId)).data.location.provinceCode == d.region.provinceCode
        && get(businessPath(d.targetId)).data.location.districtId == d.region.districtId
        && get(businessPath(d.targetId)).data.verification.status != 'dogrulandi';
    }
    function isBusinessOwner(bid) {
      return signedIn() && exists(businessPath(bid)) && get(businessPath(bid)).data.ownerUid == request.auth.uid;
    }
    // İlk aşama onayı: onaylayan kendisi, e-postası (güvenilir yönetici listesiyle eşleşir) ve şimdiki zaman.
    function myStep(f) {
      return f is map && f.keys().hasOnly(['uid', 'email', 'name', 'at'])
        && f.uid == request.auth.uid && f.email == request.auth.token.get('email', '')
        && f.name is string && f.name.size() >= 1 && f.name.size() <= 80
        && f.at == request.time;
    }
    function myDecision(dec, stage, rejected) {
      return dec is map && dec.keys().hasOnly(['uid', 'at', 'stage', 'reason'])
        && dec.uid == request.auth.uid && dec.at == request.time && dec.stage == stage
        && (rejected ? (dec.reason is string && dec.reason.size() >= 5 && dec.reason.size() <= 300) : !('reason' in dec));
    }

    match /approvals/{id} {
      // İsteyen ve işletme sahibi kendi isteğini; onay yetkisi olan il yöneticisi kendi ilindekileri; admin hepsini görür.
      allow read: if resource == null || isAdmin()
        || (signedIn() && resource.data.requestedBy == request.auth.uid)
        || regionAllows('onaylar', 'goruntule', resource.data.region.provinceCode, null)
        || (resource.data.kind == 'isletme-dogrulama' && isBusinessOwner(resource.data.targetId));
      // İşletme sahibi doğrulama ister; reddedilen ya da sonradan doğrulaması kaldırılan istek yeniden gönderilir.
      // (Ucuz denetimler önce: kuralların hesap sınırı aşılmasın.)
      allow create, update: if request.resource.data.status == 'il-onayi-bekliyor'
        && request.resource.data.requestedBy == request.auth.uid
        && !('firstApproval' in request.resource.data) && !('decision' in request.resource.data)
        && (resource == null || !(resource.data.status in ['il-onayi-bekliyor', 'admin-onayi-bekliyor']))
        && validApproval(id, request.resource.data)
        && isBusinessOwner(request.resource.data.targetId)
        && businessTargetOk(request.resource.data);
      // İl yöneticisi istek gelmemiş bir işletmeyi kendisi önerir: 1. aşama onaylı olarak admin'e gider. Kendi işletmesini öneremez.
      allow create, update: if request.resource.data.status == 'admin-onayi-bekliyor'
        && request.resource.data.requestedBy == request.auth.uid
        && !('decision' in request.resource.data)
        && (resource == null || !(resource.data.status in ['il-onayi-bekliyor', 'admin-onayi-bekliyor']))
        && myStep(request.resource.data.firstApproval)
        && validApproval(id, request.resource.data)
        && regionAllows(request.resource.data.module, 'onayla', request.resource.data.region.provinceCode, request.resource.data.region.districtId)
        && !isBusinessOwner(request.resource.data.targetId)
        && businessTargetOk(request.resource.data);
      // 1. aşama: il yöneticisi kendi ilinde onaylar (admin'e gider) ya da gerekçeyle reddeder. Kendi isteğine karar veremez.
      allow update: if resource.data.status == 'il-onayi-bekliyor'
        && request.resource.data.status in ['admin-onayi-bekliyor', 'reddedildi']
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'admin-onayi-bekliyor'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'firstApproval', 'updatedAt'])
              && myStep(request.resource.data.firstApproval))
            || (request.resource.data.status == 'reddedildi'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'updatedAt'])
              && myDecision(request.resource.data.decision, 1, true)))
        && regionAllows(resource.data.module, 'onayla', resource.data.region.provinceCode, resource.data.region.districtId);
      // 2. aşama: admin bekleyen işi onaylar ya da gerekçeyle reddeder (il yöneticisi yoksa 1. aşamayı da atlayabilir).
      allow update: if resource.data.status in ['il-onayi-bekliyor', 'admin-onayi-bekliyor']
        && request.resource.data.status in ['onaylandi', 'reddedildi']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'updatedAt'])
        && isAdmin()
        && myDecision(request.resource.data.decision, 2, request.resource.data.status == 'reddedildi')
        && request.resource.data.updatedAt == request.time;
      // İsteyen geri çeker; işletme silinince istek de silinir (hesap silmede de). Kararlar işlem kaydında kalır.
      allow delete: if signedIn() && (resource.data.requestedBy == request.auth.uid
        || (resource.data.kind == 'isletme-dogrulama' && isBusinessOwner(resource.data.targetId)));
    }

    // Güvenilir yöneticiler (PROJE.md 6.5): yalnızca admin görür ve yönetir. Silinmez, listeden çıkarılır.
    match /trustedApprovers/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'provinceCode', 'districtId', 'modules',
             'addedBy', 'addedAt', 'updatedAt'])
        && validEmail(request.resource.data.email)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.provinceCode is string && request.resource.data.provinceCode.matches('^[0-8][0-9]$')
        && (!('districtId' in request.resource.data) || (request.resource.data.districtId is string
            && request.resource.data.districtId.matches('^' + request.resource.data.provinceCode + '-[a-z0-9-]+$')))
        && id == request.resource.data.email + '__' + ('districtId' in request.resource.data
            ? 'ilce-' + request.resource.data.districtId : 'il-' + request.resource.data.provinceCode)
        && request.resource.data.modules is list
        && request.resource.data.modules.hasOnly(['isletme-dogrulama', 'bildirimler', 'etkinlikler', 'kurumlar', 'moderasyon'])
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && resource.data.get('removedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removedAt', 'removedBy', 'updatedAt'])
        && request.resource.data.removedAt == request.time
        && request.resource.data.removedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---- Resmî duyurular (PROJE.md 6.2, 6.6, 6.7): kurum personeli, muhtar ve il yöneticisi yazar. "Ekle" taslak yazar
    // ve onaya gönderir; "Onaysız yayınla" ya da "Onayla" işaretli olan doğrudan yayınlar; "Onayla" olan başkasınınkini
    // onaylar. Muhtar / il yöneticisi duyurusunun onayı il yöneticisinde. Yayındakini herkes okur.
    function regionWithin(r, sc) {
      return sc.level == 'ulke'
        || (r.provinceCode == sc.provinceCode
            && (sc.level == 'il'
                || (r.get('districtId', null) == sc.districtId
                    && (sc.level == 'ilce' || r.get('neighbourhoodId', null) == sc.neighbourhoodId))));
    }
    // Kurum personelinin bir bölümdeki işaretli eylemleri (görev listesi; eski biçimde boş sayılır).
    function staffCan(orgId, module, action) {
      return isMemberOf(orgId) && module in get(orgPath(orgId)).data.modules
        && get(memberPath(orgId)).data.assignments.get(module, []) is list
        && get(memberPath(orgId)).data.assignments.get(module, []).hasAny([action]);
    }
    // Yayınlayan hesabın (kurum ya da kişi yetkisi) bu bölümdeki işaretli eylemleri. Hesap geçersizse, kurum adı tutmuyorsa
    // ya da hedef bölge hesabın bölgesinin dışındaysa boş liste. (Bir kez hesaplanır: kuralların hesap sınırı aşılmasın.)
    function orgAuthorActions(d, module) {
      let ok = d.author.keys().hasOnly(['type', 'orgId', 'name']) && d.author.orgId is string && isMemberOf(d.author.orgId);
      let org = ok ? get(orgPath(d.author.orgId)).data : null;
      let acts = ok ? get(memberPath(d.author.orgId)).data.assignments.get(module, []) : [];
      return ok && module in org.modules && d.author.name == org.name && regionWithin(d.region, org.scope) && acts is list ? acts : [];
    }
    function personAuthorActions(d, module) {
      let ok = d.author.keys().hasOnly(['type', 'role', 'grantKey']) && d.author.grantKey is string
        && d.author.role in ['muhtar', 'il-yoneticisi'] && verified() && exists(grantPath(d.author.grantKey));
      let g = ok ? get(grantPath(d.author.grantKey)).data : null;
      return ok && g.get('revokedAt', null) == null && (g.get('expiresAt', null) == null || g.expiresAt > request.time)
        && g.role == d.author.role && regionWithin(d.region, g.scope) ? g.modules.get(module, []) : [];
    }
    function authorActions(d, module) {
      return d.author.type == 'kurum' ? orgAuthorActions(d, module) : d.author.type == 'kisi' ? personAuthorActions(d, module) : [];
    }
    function authorCan(d, module, action) {
      return authorActions(d, module).hasAny([action]);
    }
    // Hazırlayanın yazabileceği durum: "Ekle" ile taslak / onaya gönder; "Onaysız yayınla" ya da "Onayla" ile doğrudan yayınla.
    function authorWriteOk(d, module) {
      let acts = authorActions(d, module);
      return acts.hasAny(['ekle'])
        && ((d.status in ['taslak', 'onay-bekliyor'] && !('publishedAt' in d))
            || (d.status == 'yayinda' && d.publishedAt == request.time && acts.hasAny(['yayinla', 'onayla'])));
    }
    // Başkasının hazırladığını onaylayan / yayından kaldıran: kurumda "Onayla" işaretli personel; kişi içeriğinde
    // o ilde onay yetkisi olan il yöneticisi; admin.
    function canReview(d, module) {
      return isAdmin()
        || (d.author.type == 'kurum' ? staffCan(d.author.orgId, module, 'onayla')
            : grantAllows('il-' + d.region.provinceCode, module, 'onayla'));
    }
    function validAnnouncement(d) {
      return d.keys().hasOnly(['kind', 'title', 'body', 'region', 'endsAt', 'pinned', 'category', 'author', 'status', 'preparedBy',
             'preparedByName', 'createdAt', 'updatedAt', 'publishedAt', 'reviewedBy', 'reviewNote'])
        // Sabitleme yalnızca mahalleye yönelik, acil olmayan duyuruda (Mahalle Meydanı).
        && (!('pinned' in d) || (d.pinned == true && d.kind == 'duyuru' && 'neighbourhoodId' in d.region))
        && d.kind in ['duyuru', 'haber', 'acil']
        // Kurum haberi (PROJE.md 5.3): kategori yalnızca haberde ve orada zorunlu.
        && (d.kind == 'haber'
            ? ('category' in d && d.category in ['gundem', 'hizmet', 'ulasim', 'kultur-sanat', 'spor', 'egitim', 'saglik', 'cevre', 'ekonomi'])
            : !('category' in d))
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 100
        && d.body is string && d.body.size() >= 10 && d.body.size() <= 2000
        && validLocation(d.region)
        && (!('endsAt' in d) || (d.endsAt is timestamp && d.endsAt > request.time))
        // Acil duyuru bitiş tarihiyle, en çok 7 gün (sürekli en üstte kalmasın).
        && (d.kind != 'acil' || ('endsAt' in d && d.endsAt <= request.time + duration.value(7, 'd') + duration.value(1, 'h')))
        && d.author is map
        && d.preparedBy == request.auth.uid
        && d.preparedByName is string && d.preparedByName.size() <= 80
        && d.updatedAt == request.time;
    }
    // Hazırlayanın seçebileceği durum: taslak, onaya gönder ya da (yetkisi varsa) doğrudan yayınla.

    match /announcements/{id} {
      allow read: if resource.data.status == 'yayinda'
        || (signedIn() && resource.data.preparedBy == request.auth.uid)
        || isAdmin()
        || (resource.data.author.type == 'kurum' && isMemberOf(resource.data.author.orgId))
        || (resource.data.author.type == 'kisi' && grantAllows('il-' + resource.data.region.provinceCode, 'gonderiler', 'onayla'));
      // (Ucuz denetimler önce: kuralların hesap sınırı aşılmasın.)
      allow create: if request.resource.data.preparedBy == request.auth.uid
        && !('reviewedBy' in request.resource.data) && !('reviewNote' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && validAnnouncement(request.resource.data)
        && authorWriteOk(request.resource.data, 'gonderiler');
      // Hazırlayan: yayında olmayanı düzenler / yeniden gönderir. Yayınlayan hesap ve oluşturma tarihi değişmez.
      allow update: if resource.data.preparedBy == request.auth.uid
        && resource.data.status in ['taslak', 'onay-bekliyor', 'reddedildi']
        && request.resource.data.author == resource.data.author
        && request.resource.data.createdAt == resource.data.createdAt
        && !('reviewedBy' in request.resource.data) && !('reviewNote' in request.resource.data)
        && validAnnouncement(request.resource.data)
        && authorWriteOk(request.resource.data, 'gonderiler');
      // Onay ya da gerekçeli ret (yalnızca durum ve inceleme bilgisi değişir).
      allow update: if resource.data.status == 'onay-bekliyor'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'yayinda' && request.resource.data.publishedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'publishedAt', 'reviewedBy', 'updatedAt']))
            || (request.resource.data.status == 'reddedildi'
              && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() >= 5
              && request.resource.data.reviewNote.size() <= 300
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'updatedAt'])))
        && canReview(resource.data, 'gonderiler');
      // Yayından kaldırma: onaylayan, admin ya da "Sil" yetkisi olan hazırlayan.
      allow update: if resource.data.status == 'yayinda'
        && request.resource.data.status == 'kaldirildi'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt'])
        && (canReview(resource.data, 'gonderiler')
            || (resource.data.preparedBy == request.auth.uid && authorCan(resource.data, 'gonderiler', 'sil')));
      // Silinmez: kayıt için kalır.
      allow delete: if false;
    }

    // ---- Etkinlikler (PROJE.md 5.3, 6.2 madde 3): duyurularla aynı hazırla > onayla > yayınla akışı, bölüm "etkinlikler".
    // Bilet satılmaz (yalnızca https bağlantı), en çok 60 gün sürer. Katılım sayacı yalnızca katılım kaydıyla birlikte
    // tam bir artar / azalır, kontenjan aşılamaz.
    function validEvent(d) {
      return d.keys().hasOnly(['title', 'description', 'category', 'startsAt', 'endsAt', 'venueName', 'address', 'region', 'free',
             'priceNote', 'ticketUrl', 'capacity', 'author', 'status', 'preparedBy', 'preparedByName', 'createdAt', 'updatedAt',
             'publishedAt', 'reviewedBy', 'reviewNote', 'attendeeCount'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 100
        && d.description is string && d.description.size() >= 10 && d.description.size() <= 3000
        && d.category in ['kultur-sanat', 'muzik', 'tiyatro-sinema', 'spor', 'cocuk-aile', 'egitim-seminer', 'festival-senlik',
                          'saglik', 'gonulluluk', 'diger']
        && d.startsAt is timestamp && d.endsAt is timestamp && d.startsAt <= d.endsAt && d.endsAt > request.time
        && d.endsAt <= d.startsAt + duration.value(60, 'd')
        && d.venueName is string && d.venueName.size() >= 2 && d.venueName.size() <= 120
        && (!('address' in d) || (d.address is string && d.address.size() <= 200))
        && validLocation(d.region)
        && d.free is bool
        && (d.free ? !('priceNote' in d) : (d.priceNote is string && d.priceNote.size() >= 1 && d.priceNote.size() <= 80))
        && (!('ticketUrl' in d) || (d.ticketUrl is string && d.ticketUrl.size() <= 300 && d.ticketUrl.matches('^https://[^ ]+[.][^ ]+$')))
        && (!('capacity' in d) || (d.capacity is int && d.capacity >= 1 && d.capacity <= 100000))
        && d.attendeeCount is int
        && d.author is map
        && d.preparedBy == request.auth.uid
        && d.preparedByName is string && d.preparedByName.size() <= 80
        && d.updatedAt == request.time;
    }
    function eventPath(id) {
      return /databases/$(database)/documents/events/$(id);
    }
    function myAttendancePath(id) {
      return /databases/$(database)/documents/events/$(id)/attendees/$(request.auth.uid);
    }
    // Organizatör tarafı: hazırlayan, kurumda etkinlik bölümünü gören personel, kişi yetkisinin sahibi, onaylayan, admin.
    function managesEvent(e) {
      return isAdmin() || (signedIn() && e.preparedBy == request.auth.uid)
        || (e.author.type == 'kurum' ? staffCan(e.author.orgId, 'etkinlikler', 'goruntule')
            : grantAllows(e.author.grantKey, 'etkinlikler', 'goruntule'))
        || canReview(e, 'etkinlikler');
    }

    match /events/{id} {
      allow read: if resource.data.status in ['yayinda', 'iptal']
        || (signedIn() && resource.data.preparedBy == request.auth.uid)
        || isAdmin()
        || (resource.data.author.type == 'kurum' && isMemberOf(resource.data.author.orgId))
        || (resource.data.author.type == 'kisi' && grantAllows('il-' + resource.data.region.provinceCode, 'etkinlikler', 'onayla'));
      allow create: if request.resource.data.preparedBy == request.auth.uid
        && request.resource.data.attendeeCount == 0
        && !('reviewedBy' in request.resource.data) && !('reviewNote' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && validEvent(request.resource.data)
        && authorWriteOk(request.resource.data, 'etkinlikler');
      // Hazırlayan: yayında olmayanı düzenler / yeniden gönderir.
      allow update: if resource.data.preparedBy == request.auth.uid
        && resource.data.status in ['taslak', 'onay-bekliyor', 'reddedildi']
        && request.resource.data.author == resource.data.author
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.attendeeCount == resource.data.attendeeCount
        && !('reviewedBy' in request.resource.data) && !('reviewNote' in request.resource.data)
        && validEvent(request.resource.data)
        && authorWriteOk(request.resource.data, 'etkinlikler');
      // Onay ya da gerekçeli ret.
      allow update: if resource.data.status == 'onay-bekliyor'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'yayinda' && request.resource.data.publishedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'publishedAt', 'reviewedBy', 'updatedAt']))
            || (request.resource.data.status == 'reddedildi'
              && request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() >= 5
              && request.resource.data.reviewNote.size() <= 300
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'updatedAt'])))
        && canReview(resource.data, 'etkinlikler');
      // İptal (görünür kalır) ve yayından kaldırma: onaylayan, admin ya da hazırlayan (iptal için "Ekle", kaldırma için "Sil").
      allow update: if request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt'])
        && ((resource.data.status == 'yayinda' && request.resource.data.status == 'iptal'
              && (canReview(resource.data, 'etkinlikler')
                  || (resource.data.preparedBy == request.auth.uid && authorCan(resource.data, 'etkinlikler', 'ekle'))))
            || (resource.data.status in ['yayinda', 'iptal'] && request.resource.data.status == 'kaldirildi'
              && (canReview(resource.data, 'etkinlikler')
                  || (resource.data.preparedBy == request.auth.uid && authorCan(resource.data, 'etkinlikler', 'sil')))));
      // "Katılıyorum" sayacı: yalnızca kendi katılım kaydıyla birlikte tam bir artar (yayındaki, bitmemiş etkinlikte,
      // kontenjan içinde) ya da azalır.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount'])
        && ((request.resource.data.attendeeCount == resource.data.attendeeCount + 1
              && !exists(myAttendancePath(id)) && existsAfter(myAttendancePath(id))
              && resource.data.status == 'yayinda' && resource.data.endsAt > request.time
              && (!('capacity' in resource.data) || request.resource.data.attendeeCount <= resource.data.capacity))
            || (request.resource.data.attendeeCount == resource.data.attendeeCount - 1
              && exists(myAttendancePath(id)) && !existsAfter(myAttendancePath(id))));
      allow delete: if false;

      // Katılım: kişi kendisi ekler ve siler. Ad yalnızca izin verilirse yazılır; organizatör yalnızca adını paylaşanları görür.
      match /attendees/{uid} {
        allow read: if isSelf(uid) || (resource.data.shareName == true && managesEvent(get(eventPath(id)).data));
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'shareName', 'displayName', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.shareName is bool
          && (request.resource.data.shareName
              ? (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1
                  && request.resource.data.displayName.size() <= 60)
              : !('displayName' in request.resource.data))
          && request.resource.data.createdAt == request.time
          && getAfter(eventPath(id)).data.attendeeCount == get(eventPath(id)).data.attendeeCount + 1;
        allow delete: if isSelf(uid)
          && getAfter(eventPath(id)).data.attendeeCount == get(eventPath(id)).data.attendeeCount - 1;
        allow update: if false;
      }
    }
    // Hesap silmede kişinin bütün katılımları bulunur.
    match /{path=**}/attendees/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Kullanıcı aktiviteleri (PROJE.md 5.3): her yetişkin kullanıcı kendi ilinde açar. Herkes (giriş yapmış) mahalleyi
    // görür; tam buluşma yeri ayrı belgede, yalnızca düzenleyen ve katılanlar okur. Yalnızca 18 yaş ve üstü açar ve katılır.
    // Tarih ve yer sonradan değişmez (değişiklik bildirimi yok), yalnızca iptal edilir. Sayaçlar yalnızca kendi katılım ya
    // da şikâyet kaydıyla birlikte tam bir değişir. Moderatör (admin, ildeki moderasyon yetkisi) kaldırır ya da bırakır.
    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isAdultUser() {
      return signedIn() && exists(myUserPath()) && ageOf(get(myUserPath()).data.birthYear) >= 18;
    }
    function activityPath(id) {
      return /databases/$(database)/documents/activities/$(id);
    }
    function myActivityAttendance(id) {
      return /databases/$(database)/documents/activities/$(id)/attendees/$(request.auth.uid);
    }
    function myActivityReport(id) {
      return /databases/$(database)/documents/activityReports/$(id + '_' + request.auth.uid);
    }
    function validActivity(d) {
      return d.keys().hasOnly(['title', 'description', 'category', 'startsAt', 'endsAt', 'region', 'capacity', 'status',
             'organizerUid', 'organizerName', 'attendeeCount', 'reportCount', 'cleared', 'moderatedBy', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.description is string && d.description.size() >= 10 && d.description.size() <= 1000
        && d.category in ['yuruyus-doga', 'spor', 'kahve-sohbet', 'oyun', 'kitap-kultur', 'cocuk-aile', 'ogrenme', 'gonullu', 'diger']
        && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt > d.startsAt
        && d.endsAt <= d.startsAt + duration.value(12, 'h')
        && validLocation(d.region) && 'neighbourhoodId' in d.region
        && d.capacity is int && d.capacity >= 1 && d.capacity <= 50
        && d.organizerName is string && d.organizerName.size() <= 40
        && d.attendeeCount is int && d.reportCount is int
        && d.updatedAt == request.time;
    }

    match /activities/{id} {
      allow read: if signedIn()
        && (resource.data.status in ['aktif', 'iptal'] || resource.data.organizerUid == request.auth.uid
            || regionAllows('moderasyon', 'goruntule', resource.data.region.provinceCode, resource.data.region.districtId));
      // Açma: yetişkin, kendi adına, kendi ilinde, en çok 30 gün sonrası için; tam adres aynı yazımda.
      allow create: if request.resource.data.organizerUid == request.auth.uid
        && request.resource.data.status == 'aktif'
        && request.resource.data.attendeeCount == 0 && request.resource.data.reportCount == 0
        && !('cleared' in request.resource.data) && !('moderatedBy' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && validActivity(request.resource.data)
        && request.resource.data.startsAt > request.time
        && request.resource.data.startsAt <= request.time + duration.value(30, 'd')
        && isAdultUser()
        && get(myUserPath()).data.get('location', {}).get('provinceCode', '') == request.resource.data.region.provinceCode
        && existsAfter(/databases/$(database)/documents/activities/$(id)/private/details);
      // Düzenleyen: iptal eder ya da (hesap silmede) kaldırır; başka bir şey değişmez.
      allow update: if resource.data.organizerUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((resource.data.status == 'aktif' && request.resource.data.status == 'iptal'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
            || (request.resource.data.status == 'kaldirildi' && request.resource.data.organizerName == ''
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'organizerName', 'updatedAt'])));
      // "Katılıyorum" sayacı: yalnızca kendi katılım kaydıyla tam bir artar (yetişkin, düzenleyen değil, aktif, başlamamış,
      // kontenjan içinde) ya da azalır.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount'])
        && ((request.resource.data.attendeeCount == resource.data.attendeeCount + 1
              && !exists(myActivityAttendance(id)) && existsAfter(myActivityAttendance(id))
              && resource.data.status == 'aktif' && resource.data.startsAt > request.time
              && resource.data.organizerUid != request.auth.uid
              && request.resource.data.attendeeCount <= resource.data.capacity
              && isAdultUser())
            || (request.resource.data.attendeeCount == resource.data.attendeeCount - 1
              && exists(myActivityAttendance(id)) && !existsAfter(myActivityAttendance(id))));
      // Şikâyet sayacı: yalnızca kendi şikâyet kaydıyla tam bir artar.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && !exists(myActivityReport(id)) && existsAfter(myActivityReport(id));
      // Moderasyon: kaldır ya da "yerinde kalsın".
      allow update: if request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cleared', 'moderatedBy', 'updatedAt'])
        && (request.resource.data.status == 'kaldirildi'
            || (request.resource.data.status == resource.data.status && request.resource.data.cleared == true))
        && (isAdmin() || regionAllows('moderasyon', 'duzenle', resource.data.region.provinceCode, resource.data.region.districtId));
      allow delete: if false;

      // Tam buluşma yeri: düzenleyen, katılanlar ve admin okur. Aktiviteyle birlikte yazılır; hesap silmede düzenleyen siler.
      match /private/{doc} {
        allow read: if signedIn()
          && (get(activityPath(id)).data.organizerUid == request.auth.uid || exists(myActivityAttendance(id)) || isAdmin());
        allow create: if doc == 'details' && !exists(activityPath(id))
          && getAfter(activityPath(id)).data.organizerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['address'])
          && request.resource.data.address is string
          && request.resource.data.address.size() >= 5 && request.resource.data.address.size() <= 200;
        allow delete: if signedIn() && get(activityPath(id)).data.organizerUid == request.auth.uid;
        allow update: if false;
      }

      // Katılım: kişi kendisi ekler ve siler. Ad yalnızca izinle yazılır; düzenleyen yalnızca adını paylaşanları görür.
      match /attendees/{uid} {
        allow read: if isSelf(uid) || (resource.data.shareName == true && get(activityPath(id)).data.organizerUid == request.auth.uid);
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'shareName', 'displayName', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.shareName is bool
          && (request.resource.data.shareName
              ? (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1
                  && request.resource.data.displayName.size() <= 60)
              : !('displayName' in request.resource.data))
          && request.resource.data.createdAt == request.time
          && getAfter(activityPath(id)).data.attendeeCount == get(activityPath(id)).data.attendeeCount + 1;
        allow delete: if isSelf(uid)
          && getAfter(activityPath(id)).data.attendeeCount == get(activityPath(id)).data.attendeeCount - 1;
        allow update: if false;
      }
    }

    // Aktivite şikâyetleri: kişi başına aktivite başına bir; kendi aktivitesini şikâyet edemez. Admin hepsini, ildeki
    // moderasyon yetkisi olan kendi ilini görür ve "incelendi" yapar.
    match /activityReports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['activityId', 'reporterUid', 'reason', 'provinceCode', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && rid == request.resource.data.activityId + '_' + request.auth.uid
        && request.resource.data.reason in ['tehlikeli', 'uygunsuz', 'ticari', 'sahte', 'diger']
        && request.resource.data.status == 'yeni'
        && request.resource.data.createdAt == request.time
        && get(activityPath(request.resource.data.activityId)).data.organizerUid != request.auth.uid
        && request.resource.data.provinceCode == get(activityPath(request.resource.data.activityId)).data.region.provinceCode
        && getAfter(activityPath(request.resource.data.activityId)).data.reportCount
           == get(activityPath(request.resource.data.activityId)).data.reportCount + 1;
      // Kişi kendi şikâyetini görür ("şikâyet ettiniz" bilgisi için).
      allow read: if (signedIn() && (resource == null || resource.data.reporterUid == request.auth.uid))
        || regionAllows('moderasyon', 'goruntule', resource.data.provinceCode, null);
      allow update: if regionAllows('moderasyon', 'duzenle', resource.data.provinceCode, null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'incelendi';
      allow delete: if false;
    }

    // ---- Keşfet gönderileri (PROJE.md 5.5): giriş yapmış kullanıcı kendi kayıtlı konumuyla paylaşır, bir ya da birden
    // çok hedef seçer. Mahallem gönderisini yalnızca o mahallede kayıtlı olan, Bölgesel'i yalnızca o ilde kayıtlı olan,
    // Genel'i her giriş yapmış kişi okur. Sayaçlar yalnızca kendi beğeni ya da şikâyet kaydıyla tam bir değişir. Sahibi
    // gönderisini boşaltarak kaldırır; moderatör (admin, ildeki moderasyon yetkisi) kaldırır ya da bırakır.
    function postPath(id) {
      return /databases/$(database)/documents/posts/$(id);
    }
    function myLocation() {
      return get(myUserPath()).data.get('location', {});
    }
    function validPost(d) {
      return d.keys().hasOnly(['text', 'category', 'targets', 'region', 'status', 'authorUid', 'authorName', 'business', 'likeCount',
             'commentCount', 'commentsOff', 'lastComment', 'reportCount', 'cleared', 'moderatedBy', 'searchKeys', 'createdAt', 'updatedAt'])
        && d.text is string && d.text.size() <= 2000
        && validSearchKeys(d, 300)
        && d.category in ['genel', 'duyuru', 'etkinlik', 'firsat', 'soru-yardim', 'kayip-buluntu', 'taziye']
        && d.targets is map && d.targets.keys().hasOnly(['mahallem', 'bolgesel', 'genel', 'takip'])
        && d.targets.keys().hasAll(['mahallem', 'bolgesel', 'genel'])
        && d.targets.mahallem is bool && d.targets.bolgesel is bool && d.targets.genel is bool
        && d.targets.get('takip', false) is bool
        && (d.targets.mahallem || d.targets.bolgesel || d.targets.genel || d.targets.get('takip', false))
        && validLocation(d.region) && 'neighbourhoodId' in d.region
        && d.authorName is string && d.authorName.size() <= 40
        && d.likeCount is int && d.reportCount is int
        && d.updatedAt == request.time;
    }
    function canSeePost(d) {
      // Hedefler sabit anahtarlı bir haritada durur ({mahallem, bolgesel, genel}: true/false): akış sorguları bunlarla
      // süzülür ve kurallar sorguyu doğrulayabilir.
      return d.targets.get('genel', false) == true
        || (d.targets.get('bolgesel', false) == true && myLocation().get('provinceCode', '') == d.region.provinceCode)
        || (d.targets.get('mahallem', false) == true && myLocation().get('neighbourhoodId', '') == d.region.neighbourhoodId)
        || (d.targets.get('takip', false) == true
            && ('business' in d ? exists(businessFollowPath(d.business.id, request.auth.uid)) : isFollowerOf(d.authorUid)));
    }
    // İşletme adına paylaşım: sahibi doğrudan; yetkili izni "doğrudan" ise yayında, "onayla" ise onay bekler.
    // Bölge işletmenin konumudur (mahallesi seçilmiş olmalı).
    function validBusinessPost(d) {
      let b = get(businessPath(d.business.id)).data;
      return d.business.keys().hasOnly(['id', 'name']) && d.business.name is string && d.business.name.size() <= 80
        && b.status == 'yayinda'
        && ((b.ownerUid == request.auth.uid && d.status == 'aktif')
            || (isManagerOf(b) && b.managers[request.auth.uid].post == 'dogrudan' && d.status == 'aktif')
            || (isManagerOf(b) && b.managers[request.auth.uid].post == 'onayla' && d.status == 'onay-bekliyor'))
        && d.region.provinceCode == b.location.provinceCode
        && d.region.districtId == b.location.districtId
        && d.region.neighbourhoodId == b.location.get('neighbourhoodId', '');
    }
    function isBusinessTeam(bid) {
      let b = get(businessPath(bid)).data;
      return b.ownerUid == request.auth.uid || isManagerOf(b);
    }
    function followPath(follower, followee) {
      return /databases/$(database)/documents/follows/$(follower + '_' + followee);
    }
    // Takip onaylanmış (gizli hesapta istek kabul edilmiş) mi.
    function isFollowerOf(uid) {
      return exists(followPath(request.auth.uid, uid)) && get(followPath(request.auth.uid, uid)).data.status == 'aktif';
    }
    function blockPath(blocker, blocked) {
      return /databases/$(database)/documents/blocks/$(blocker + '_' + blocked);
    }

    match /posts/{id} {
      allow read: if signedIn()
        && ((resource.data.status == 'aktif' && canSeePost(resource.data))
            || resource.data.authorUid == request.auth.uid
            || ('business' in resource.data && isBusinessTeam(resource.data.business.id))
            || regionAllows('moderasyon', 'goruntule', resource.data.region.provinceCode, resource.data.region.districtId));
      // Paylaşma: kendi adına kendi kayıtlı mahallesiyle, ya da işletme adına işletmenin konumuyla.
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likeCount == 0 && request.resource.data.reportCount == 0
        && request.resource.data.get('commentCount', 0) == 0
        && !('cleared' in request.resource.data) && !('moderatedBy' in request.resource.data)
        && !('commentsOff' in request.resource.data) && !('lastComment' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && validPost(request.resource.data)
        && request.resource.data.text.size() >= 1
        && ('business' in request.resource.data
            ? validBusinessPost(request.resource.data)
            : (request.resource.data.status == 'aktif'
                && exists(myUserPath())
                && myLocation().get('neighbourhoodId', '') == request.resource.data.region.neighbourhoodId
                && myLocation().get('districtId', '') == request.resource.data.region.districtId
                && myLocation().get('provinceCode', '') == request.resource.data.region.provinceCode));
      // İşletme sahibi yetkilinin bekleyen paylaşımını onaylar.
      allow update: if 'business' in resource.data && resource.data.status == 'onay-bekliyor'
        && isBusinessOwner(resource.data.business.id)
        && request.resource.data.status == 'aktif' && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      // Sahibi (işletme paylaşımında işletme sahibi de) kaldırır: yazı, ad ve arama anahtarları boşaltılır.
      allow update: if (resource.data.authorUid == request.auth.uid
            || ('business' in resource.data && isBusinessOwner(resource.data.business.id)))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status == 'kaldirildi' && request.resource.data.text == '' && request.resource.data.authorName == ''
        && !('searchKeys' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'text', 'authorName', 'searchKeys', 'updatedAt']);
      // Sahibi yorumları kapatır ya da açar.
      allow update: if resource.data.authorUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.commentsOff is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsOff', 'updatedAt']);
      // Yorum sayacı: yalnızca adı geçen yorum (lastComment) aynı yazımda eklenirken tam bir artar, silinirken azalır.
      // Kimin silebileceğini yorum kuralı denetler.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastComment'])
        && request.resource.data.lastComment is string
        && ((request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
              && !exists(/databases/$(database)/documents/posts/$(id)/comments/$(request.resource.data.lastComment))
              && existsAfter(/databases/$(database)/documents/posts/$(id)/comments/$(request.resource.data.lastComment)))
            || (request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1
              && exists(/databases/$(database)/documents/posts/$(id)/comments/$(request.resource.data.lastComment))
              && !existsAfter(/databases/$(database)/documents/posts/$(id)/comments/$(request.resource.data.lastComment))));
      // Beğeni sayacı: yalnızca kendi beğeni kaydıyla tam bir artar (görebildiği, kaldırılmamış gönderide) ya da azalır.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && ((request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(/databases/$(database)/documents/posts/$(id)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/posts/$(id)/likes/$(request.auth.uid))
              && resource.data.status == 'aktif' && canSeePost(resource.data))
            || (request.resource.data.likeCount == resource.data.likeCount - 1
              && exists(/databases/$(database)/documents/posts/$(id)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/posts/$(id)/likes/$(request.auth.uid))));
      // Şikâyet sayacı: yalnızca kendi şikâyet kaydıyla tam bir artar.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && !exists(/databases/$(database)/documents/postReports/$(id + '_' + request.auth.uid))
        && existsAfter(/databases/$(database)/documents/postReports/$(id + '_' + request.auth.uid));
      // Moderasyon: kaldır ya da "yerinde kalsın".
      allow update: if request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cleared', 'moderatedBy', 'updatedAt'])
        && (request.resource.data.status == 'kaldirildi'
            || (request.resource.data.status == resource.data.status && request.resource.data.cleared == true))
        && (isAdmin() || regionAllows('moderasyon', 'duzenle', resource.data.region.provinceCode, resource.data.region.districtId));
      allow delete: if false;

      // Beğeni: kişi kendisi ekler ve siler; yalnızca kendi beğenisini okur.
      match /likes/{uid} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time
          && getAfter(postPath(id)).data.likeCount == get(postPath(id)).data.likeCount + 1;
        allow delete: if isSelf(uid)
          && getAfter(postPath(id)).data.likeCount == get(postPath(id)).data.likeCount - 1;
        allow update: if false;
      }

      // Yorumlar: gönderiyi görebilen okur ve (yorumlar açıksa) yazar; sayaç aynı yazımda artar. Yazan, gönderi sahibi ve
      // moderatör siler. Şikâyet sayacı kendi şikâyet kaydıyla tam bir artar; moderatör "yerinde kalsın" der.
      match /comments/{cid} {
        allow read: if signedIn()
          && ((get(postPath(id)).data.status == 'aktif' && canSeePost(get(postPath(id)).data))
              || get(postPath(id)).data.authorUid == request.auth.uid
              || regionAllows('moderasyon', 'goruntule', get(postPath(id)).data.region.provinceCode, null));
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'reportCount', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 40
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.reportCount == 0
          && request.resource.data.createdAt == request.time
          && get(postPath(id)).data.status == 'aktif' && canSeePost(get(postPath(id)).data)
          && get(postPath(id)).data.get('commentsOff', false) != true
          // Gönderi sahibi beni engellediyse yorum yazamam.
          && !exists(blockPath(get(postPath(id)).data.authorUid, request.auth.uid))
          && getAfter(postPath(id)).data.commentCount == get(postPath(id)).data.get('commentCount', 0) + 1;
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid
              || get(postPath(id)).data.authorUid == request.auth.uid
              || isAdmin() || regionAllows('moderasyon', 'sil', get(postPath(id)).data.region.provinceCode, null))
          && getAfter(postPath(id)).data.commentCount == get(postPath(id)).data.get('commentCount', 0) - 1;
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
          && request.resource.data.reportCount == resource.data.reportCount + 1
          && !exists(/databases/$(database)/documents/commentReports/$(id + '_' + cid + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/commentReports/$(id + '_' + cid + '_' + request.auth.uid));
        allow update: if request.resource.data.moderatedBy == request.auth.uid
          && request.resource.data.cleared == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cleared', 'moderatedBy'])
          && (isAdmin() || regionAllows('moderasyon', 'duzenle', get(postPath(id)).data.region.provinceCode, null));
      }
    }
    // Kişinin bütün yorumları (hesap silme için).
    match /{path=**}/comments/{cid} {
      allow read: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Yorum şikâyetleri: kişi başına yorum başına bir; yorumun yazısı kopyalanır (silinse de moderatör görür).
    match /commentReports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'commentId', 'reporterUid', 'reason', 'text', 'provinceCode', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && rid == request.resource.data.postId + '_' + request.resource.data.commentId + '_' + request.auth.uid
        && request.resource.data.reason in ['nefret', 'taciz', 'dolandiricilik', 'spam', 'uygunsuz', 'emlak', 'diger']
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.status == 'yeni'
        && request.resource.data.createdAt == request.time
        && request.resource.data.provinceCode == get(postPath(request.resource.data.postId)).data.region.provinceCode
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)).data.authorUid != request.auth.uid;
      allow read: if (signedIn() && (resource == null || resource.data.reporterUid == request.auth.uid))
        || regionAllows('moderasyon', 'goruntule', resource.data.provinceCode, null);
      allow update: if regionAllows('moderasyon', 'duzenle', resource.data.provinceCode, null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'incelendi';
      allow delete: if false;
    }
    // ---- Mesajlar (PROJE.md 5.11). Birebir, yalnızca yazı. Sohbet "kişi_kişi" (sıralı) kimlikli; mesaj ve sohbet özeti
    // (son mesaj, okunmamış sayısı) aynı yazımda değişir. Takipleşmeyen kişiden gelen sohbet alıcıda istektir. Yetişkin
    // ile 13-17 yaş arası kişi arasında sohbet açılamaz; engel iki yönde de yazışmayı durdurur. Yeni sohbet sayısı 24 saatte
    // sınırlı (yeni hesapta 10, sonra 30). Mesajları yalnızca iki taraf okur; admin yalnızca şikâyet edilen mesajın kopyasını.
    function chatPath(id) {
      return /databases/$(database)/documents/chats/$(id);
    }
    function chatMessagePath(id, mid) {
      return /databases/$(database)/documents/chats/$(id)/messages/$(mid);
    }
    function quotaPath() {
      return /databases/$(database)/documents/chatQuota/$(request.auth.uid);
    }
    function isMinor(uid) {
      return ageOf(get(/databases/$(database)/documents/users/$(uid)).data.birthYear) < 18;
    }
    function notBlockedPair(a, b) {
      return !exists(blockPath(a, b)) && !exists(blockPath(b, a));
    }
    // Bu bölümde exists() yerine doğrudan get(): belge yoksa get hata verir ve istek zaten reddedilir. Böylece ilk
    // mesajın toplu yazımı Firestore'un istek başına belge okuma sınırının (20) altında kalır.
    function followsActive(a, b) {
      return get(followPath(a, b)).data.status == 'aktif';
    }
    function otherOf(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }
    function profileName(uid) {
      return get(/databases/$(database)/documents/publicProfiles/$(uid)).data.displayName;
    }
    function chatLimit() {
      return get(myUserPath()).data.createdAt > request.time - duration.value(7, 'd') ? 10 : 30;
    }
    // Son mesaj özeti: aynı yazımda eklenen, benim yazdığım mesajı gösterir.
    function validLast(id, last) {
      return last.keys().hasOnly(['id', 'text', 'from', 'at'])
        && last.from == request.auth.uid && last.at == request.time
        && last.text is string && last.text.size() <= 80
        && getAfter(chatMessagePath(id, last.id)).data.from == request.auth.uid;
    }
    // Yeni sohbet sayacı bu yazımda değişti (sayacın kendi kuralı yalnızca +1 ya da süresi dolunca sıfırlamaya izin verir).
    function quotaCounted() {
      return getAfter(quotaPath()).data.count <= chatLimit()
        && (!exists(quotaPath()) || getAfter(quotaPath()).data != get(quotaPath()).data);
    }
    // İşletmeye yazılan sohbet: kimliğin sonunda işletme, karşı taraf işletmenin sahibi, işletme yayında; baştan açık.
    function businessChat(id, d, other) {
      return d.context.keys().hasOnly(['type', 'id', 'title']) && d.context.type == 'isletme'
        && id == d.members[0] + '_' + d.members[1] + '__b_' + d.context.id
        && get(/databases/$(database)/documents/businesses/$(d.context.id)).data.ownerUid == other
        && get(/databases/$(database)/documents/businesses/$(d.context.id)).data.status == 'yayinda'
        && d.context.title == get(/databases/$(database)/documents/businesses/$(d.context.id)).data.name
        && d.names[other] == d.context.title
        && d.accepted == true;
    }
    function personChat(id, d, other) {
      return id == d.members[0] + '_' + d.members[1]
        && d.names[other] == profileName(other)
        && (d.accepted == false || (d.accepted == true && followsActive(request.auth.uid, other) && followsActive(other, request.auth.uid)));
    }
    function validNewChat(id, d, other) {
      return d.keys().hasOnly(['members', 'names', 'startedBy', 'accepted', 'last', 'unread', 'seen', 'context', 'createdAt', 'updatedAt'])
        && d.names.keys().hasOnly([request.auth.uid, other])
        && d.names[request.auth.uid] == profileName(request.auth.uid)
        && d.startedBy == request.auth.uid
        && ('context' in d ? businessChat(id, d, other) : personChat(id, d, other))
        && d.unread.keys().hasOnly([request.auth.uid, other]) && d.unread[request.auth.uid] == 0 && d.unread[other] == 1
        && d.seen == {}
        && validLast(id, d.last)
        && d.createdAt == request.time && d.updatedAt == request.time
        && notBlockedPair(request.auth.uid, other)
        && isMinor(request.auth.uid) == isMinor(other)
        && quotaCounted();
    }
    function chatSending(id, before, after, other) {
      return after.diff(before).affectedKeys().hasOnly(['last', 'unread', 'updatedAt', 'accepted'])
        && validLast(id, after.last)
        && after.unread.keys().hasOnly(before.members)
        && after.unread[other] == before.unread.get(other, 0) + 1
        && after.unread.get(request.auth.uid, 0) == before.unread.get(request.auth.uid, 0)
        && after.updatedAt == request.time
        && (after.accepted == before.accepted
            || (before.accepted == false && after.accepted == true && before.startedBy != request.auth.uid));
    }
    function chatReading(before, after, other) {
      return after.diff(before).affectedKeys().hasOnly(['unread', 'seen'])
        && after.unread.keys().hasOnly(before.members)
        && after.unread[request.auth.uid] == 0
        && after.unread.get(other, 0) == before.unread.get(other, 0)
        && after.seen.diff(before.seen).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after.seen.diff(before.seen).affectedKeys()) || after.seen[request.auth.uid] == request.time);
    }
    // "Sohbeti sil": kişi yalnızca kendi silme zamanını yazar (ve kendi okunmamışını sıfırlar); karşı tarafa dokunulmaz.
    function chatHiding(before, after, other) {
      return after.diff(before).affectedKeys().hasOnly(['hidden', 'unread'])
        && after.hidden.diff(before.get('hidden', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.hidden[request.auth.uid] == request.time
        && after.unread.keys().hasOnly(before.members)
        && after.unread[request.auth.uid] == 0
        && after.unread.get(other, 0) == before.unread.get(other, 0);
    }

    // Mesaj, aynı yazımdaki sohbet özetinin son mesajıdır; iki taraf arasında engel yoktur.
    function messageFits(chat, mid) {
      return request.auth.uid in chat.members && chat.last.id == mid && notBlockedPair(request.auth.uid, otherOf(chat.members));
    }

    match /chats/{id} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && validNewChat(id, request.resource.data, otherOf(request.resource.data.members));
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && (chatSending(id, resource.data, request.resource.data, otherOf(resource.data.members))
            || chatReading(resource.data, request.resource.data, otherOf(resource.data.members))
            || chatHiding(resource.data, request.resource.data, otherOf(resource.data.members))
            // İsteği alan kişi kabul eder.
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted'])
                && request.resource.data.accepted == true && resource.data.startedBy != request.auth.uid)
            // Kendi son mesajını silen kişi önizlemeyi boşaltır.
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
                && request.resource.data.last.diff(resource.data.last).affectedKeys().hasOnly(['text'])
                && request.resource.data.last.text == '' && resource.data.last.from == request.auth.uid));
      // Hesap silinirken.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(chatPath(id)).data.members;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'text', 'status', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.status == 'aktif'
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && messageFits(getAfter(chatPath(id)).data, mid);
        // Gönderen siler (yazı boşalır); admin şikâyet üzerine kaldırır.
        allow update: if signedIn() && resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'text'])
          && request.resource.data.status == 'silindi' && request.resource.data.text == '';
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'text'])
          && request.resource.data.status == 'kaldirildi' && request.resource.data.text == '';
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    // Yeni sohbet sayacı: yalnızca bir artar ya da 24 saat dolunca yeniden başlar; silinemez (sınır atlatılmasın).
    match /chatQuota/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['windowStart', 'count'])
        && request.resource.data.windowStart == request.time && request.resource.data.count == 1;
      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['windowStart', 'count'])
        && ((request.resource.data.windowStart == request.time && request.resource.data.count == 1
              && resource.data.windowStart + duration.value(1, 'd') <= request.time)
            || (request.resource.data.windowStart == resource.data.windowStart && request.resource.data.count == resource.data.count + 1));
    }

    // Mesaj şikâyeti: kişi başına mesaj başına bir, mesajın o anki kopyasıyla; yalnızca admin görür ve karar verir.
    match /messageReports/{rid} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.reporterUid == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId', 'messageId', 'reporterUid', 'reportedUid', 'text', 'reason', 'status', 'createdAt'])
        && rid == request.auth.uid + '_' + request.resource.data.messageId
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['taciz', 'dolandiricilik', 'spam', 'uygunsuz', 'diger']
        && request.resource.data.status == 'acik'
        && request.resource.data.createdAt == request.time
        && request.auth.uid in get(chatPath(request.resource.data.chatId)).data.members
        && get(chatMessagePath(request.resource.data.chatId, request.resource.data.messageId)).data.from == request.resource.data.reportedUid
        && request.resource.data.reportedUid != request.auth.uid
        && get(chatMessagePath(request.resource.data.chatId, request.resource.data.messageId)).data.text == request.resource.data.text;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'incelendi';
    }

    // ---- Keşfet profili, takip ve engelleme (PROJE.md 5.5, 5.8). Herkese açık profil yalnızca ad ("Ayşe K."), kısa
    // tanıtım ve gizli hesap bilgisini taşır. Takip belgesi "takipEden_takipEdilen"; gizli hesapta önce "istek", hesap
    // sahibi kabul edince "aktif". Engellenen kişi engelleyeni takip edemez, gönderisine yorum yazamaz.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      // Arama anahtarları yalnızca addan üretilir (gizli hesap da yalnızca adıyla bulunur, PROJE.md 5.10).
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'isPrivate', 'searchKeys', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && validSearchKeys(request.resource.data, 40)
        && request.resource.data.bio == ''
        && request.resource.data.isPrivate is bool
        && request.resource.data.updatedAt == request.time;
      // Kişi adını, tanıtımını ve gizliliğini değiştirir; moderatörün kaldırdığı tanıtımı yeniden yazamaz.
      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'isPrivate', 'bioRemoved', 'searchKeys', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'isPrivate', 'searchKeys', 'updatedAt'])
        && validSearchKeys(request.resource.data, 40)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && (resource.data.get('bioRemoved', false) != true || request.resource.data.bio == '')
        && request.resource.data.isPrivate is bool
        && request.resource.data.updatedAt == request.time;
      // Admin şikâyet üzerine tanıtımı kaldırır.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio', 'bioRemoved', 'updatedAt'])
        && request.resource.data.bio == '' && request.resource.data.bioRemoved == true
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    match /follows/{fid} {
      // Onaylı takipler herkese açık (takipçi sayısı); istekleri yalnızca iki taraf görür.
      allow read: if signedIn()
        && (resource.data.status == 'aktif' || resource.data.followerUid == request.auth.uid
            || resource.data.followeeUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerUid', 'followeeUid', 'status', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followeeUid is string && request.resource.data.followeeUid != request.auth.uid
        && fid == request.auth.uid + '_' + request.resource.data.followeeUid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.followeeUid))
        && request.resource.data.status == (get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.followeeUid)).data.isPrivate ? 'istek' : 'aktif')
        && !exists(blockPath(request.resource.data.followeeUid, request.auth.uid))
        && !exists(blockPath(request.auth.uid, request.resource.data.followeeUid));
      // Hesap sahibi isteği kabul eder.
      allow update: if signedIn() && resource.data.followeeUid == request.auth.uid
        && resource.data.status == 'istek' && request.resource.data.status == 'aktif'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // Takibi bırakma, isteği reddetme, takipçiyi çıkarma (engellerken yoksa da silinebilir).
      allow delete: if signedIn()
        && (resource == null || resource.data.followerUid == request.auth.uid || resource.data.followeeUid == request.auth.uid);
    }

    match /blocks/{bid} {
      allow read: if signedIn() && (resource == null || resource.data.blockerUid == request.auth.uid
        || resource.data.blockedUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string && request.resource.data.blockedUid != request.auth.uid
        && bid == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // Profil şikâyetleri: kişi başına profil başına bir; ad ve tanıtımın o anki kopyası saklanır. Profilde bölge
    // olmadığı için yalnızca admin görür ve karar verir.
    match /profileReports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['targetUid', 'reporterUid', 'reason', 'displayName', 'bio', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string && request.resource.data.targetUid != request.auth.uid
        && rid == request.resource.data.targetUid + '_' + request.auth.uid
        && request.resource.data.reason in ['taklit', 'nefret', 'taciz', 'spam', 'uygunsuz', 'diger']
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.status == 'yeni'
        && request.resource.data.createdAt == request.time;
      allow read: if (signedIn() && (resource == null || resource.data.reporterUid == request.auth.uid)) || isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'incelendi';
      allow delete: if false;
    }

    // Kişinin bütün beğenileri (akıştaki kalpler ve hesap silme için).
    match /{path=**}/likes/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Gönderi şikâyetleri: kişi başına gönderi başına bir; kendi gönderisini şikâyet edemez. Admin hepsini, ildeki
    // moderasyon yetkisi olan kendi ilini görür ve "incelendi" yapar.
    match /postReports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'reporterUid', 'reason', 'provinceCode', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && rid == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.reason in ['nefret', 'taciz', 'dolandiricilik', 'spam', 'uygunsuz', 'emlak', 'diger']
        && request.resource.data.status == 'yeni'
        && request.resource.data.createdAt == request.time
        && get(postPath(request.resource.data.postId)).data.authorUid != request.auth.uid
        && request.resource.data.provinceCode == get(postPath(request.resource.data.postId)).data.region.provinceCode
        && getAfter(postPath(request.resource.data.postId)).data.reportCount
           == get(postPath(request.resource.data.postId)).data.reportCount + 1;
      allow read: if (signedIn() && (resource == null || resource.data.reporterUid == request.auth.uid))
        || regionAllows('moderasyon', 'goruntule', resource.data.provinceCode, null);
      allow update: if regionAllows('moderasyon', 'duzenle', resource.data.provinceCode, null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'incelendi';
      allow delete: if false;
    }

    // ---- Resmî profiller (PROJE.md 6.2 madde 2): kurumun ya da muhtarlığın herkese açık künyesi (tanıtım, iletişim,
    // çalışma saatleri). Kurumda kurum yöneticisi, muhtarlıkta muhtarın kendisi, ikisinde de admin yazar. Kurumun adı ve
    // bölgesi kurum kaydından gelir, değiştirilemez. Herkes okur (girişsiz de). Silinmez, alanlar boşaltılır.
    function regionOfScope(sc) {
      return sc.level == 'il' ? {'provinceCode': sc.provinceCode}
        : sc.level == 'ilce' ? {'provinceCode': sc.provinceCode, 'districtId': sc.districtId}
        : {'provinceCode': sc.provinceCode, 'districtId': sc.districtId, 'neighbourhoodId': sc.neighbourhoodId};
    }
    function validOfficialProfile(d) {
      return d.keys().hasOnly(['type', 'name', 'region', 'about', 'phone', 'email', 'website', 'address', 'hours',
             'updatedBy', 'updatedAt'])
        && d.name is string && d.name.size() <= 120
        && (!('about' in d) || (d.about is string && d.about.size() >= 1 && d.about.size() <= 600))
        && (!('phone' in d) || (d.phone is string && d.phone.matches('^[+]?[0-9][0-9 ()-]{5,18}[0-9]$')))
        && (!('email' in d) || validEmail(d.email))
        && (!('website' in d) || (d.website is string && d.website.size() <= 200 && d.website.matches('^https://[^ ]+[.][^ ]+$')))
        && (!('address' in d) || (d.address is string && d.address.size() >= 1 && d.address.size() <= 200))
        && (!('hours' in d) || (d.hours is string && d.hours.size() >= 1 && d.hours.size() <= 200))
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function orgProfileOk(id, d) {
      let org = get(orgPath(id)).data;
      return d.type == 'kurum' && d.name == org.name
        && (org.scope.level == 'ulke' ? !('region' in d) : d.region == regionOfScope(org.scope))
        && (isAdmin() || isOrgAdminOf(id));
    }
    // Bu mahallenin geçerli muhtar yetkisi bende mi?
    function isMuhtarOf(key) {
      return verified() && exists(grantPath(key))
        && get(grantPath(key)).data.role == 'muhtar'
        && get(grantPath(key)).data.get('revokedAt', null) == null
        && (get(grantPath(key)).data.get('expiresAt', null) == null || get(grantPath(key)).data.expiresAt > request.time);
    }
    function muhtarProfileOk(id, d) {
      return d.type == 'muhtar' && d.name.size() <= 80
        && validLocation(d.region) && 'neighbourhoodId' in d.region && id == 'mahalle-' + d.region.neighbourhoodId
        && (isAdmin() || isMuhtarOf(id));
    }

    match /officialProfiles/{id} {
      allow read: if true;
      allow create, update: if validOfficialProfile(request.resource.data)
        && ((id.matches('^(bld|krm)-.+') && exists(orgPath(id)) && orgProfileOk(id, request.resource.data))
            || (id.matches('^mahalle-.+') && muhtarProfileOk(id, request.resource.data)));
      allow delete: if false;
    }

    // Yönetici işlem kaydı: yalnızca eklenir, değiştirilemez ve silinemez. Admin hepsini, her yönetici kendi
    // kayıtlarını görür. Admin olmayan yönetici yalnızca yetkisi olan bölgede ve bölümde kayıt ekler.
    // ---- Seyahat > Keşfet ve Öğren (PROJE.md 5.2): içeriği admin girer; uygulama yalnızca yayındakini okur.
    function validTravelStatus(d) {
      return d.status in ['taslak', 'yayinda'] && d.updatedAt == request.time;
    }
    function travelUrlOk(d, k) {
      return !(k in d) || (d[k] is string && d[k].size() <= 500 && d[k].matches('https://[^ ]+'));
    }
    match /travelRegions/{id} {
      allow read: if resource == null || resource.data.status == 'yayinda' || isAdmin();
      allow create, update: if isAdmin() && validTravelStatus(request.resource.data)
        && request.resource.data.keys().hasOnly(['tagline', 'description', 'videoUrl', 'status', 'updatedAt'])
        && request.resource.data.get('tagline', '') is string && request.resource.data.get('tagline', '').size() <= 60
        && request.resource.data.description is string && request.resource.data.description.size() <= 600
        && travelUrlOk(request.resource.data, 'videoUrl');
      allow delete: if isAdmin();
    }
    match /travelCities/{id} {
      allow read: if resource == null || resource.data.status == 'yayinda' || isAdmin();
      allow create, update: if isAdmin() && validTravelStatus(request.resource.data)
        && id.matches('^[0-8][0-9]$')
        && request.resource.data.keys().hasOnly(['regionId', 'tagline', 'description', 'categories', 'highlights', 'facts', 'videoUrl', 'status', 'updatedAt'])
        && request.resource.data.regionId is string
        && request.resource.data.description is string && request.resource.data.description.size() <= 600
        && request.resource.data.get('categories', []) is list && request.resource.data.get('categories', []).size() <= 6
        && request.resource.data.get('highlights', []) is list && request.resource.data.get('highlights', []).size() <= 6
        && request.resource.data.get('facts', []) is list && request.resource.data.get('facts', []).size() <= 8
        && travelUrlOk(request.resource.data, 'videoUrl');
      allow delete: if isAdmin();
    }
    match /travelPlaces/{id} {
      allow read: if resource == null || resource.data.status == 'yayinda' || isAdmin();
      allow create, update: if isAdmin() && validTravelStatus(request.resource.data)
        && request.resource.data.keys().hasOnly(['cityId', 'districtId', 'name', 'kind', 'category', 'summary', 'about', 'history',
             'architecture', 'visitingHours', 'entranceFee', 'suggestedDuration', 'address', 'howToGet', 'nearby', 'tips',
             'accessibility', 'phone', 'website', 'videoUrl', 'mustSee', 'source', 'order', 'status', 'updatedAt'])
        && request.resource.data.cityId is string && request.resource.data.cityId.matches('^[0-8][0-9]$')
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.category in ['tarih', 'doga', 'deniz', 'lezzet', 'kultur', 'alisveris']
        && request.resource.data.about is string && request.resource.data.about.size() <= 2000
        && request.resource.data.get('howToGet', []).size() <= 10 && request.resource.data.get('nearby', []).size() <= 10
        && request.resource.data.get('tips', []).size() <= 10
        && travelUrlOk(request.resource.data, 'website') && travelUrlOk(request.resource.data, 'videoUrl');
      allow delete: if isAdmin();
    }

    // ---- Seyahat 2. aşama (PROJE.md 5.2): Hazır Rotalar, Yöresel, Başkanlarla Keşif. Rota ve yöreseli CityJoy (admin)
    // girer. Belediye personeli (kurumda Seyahat bölümü işaretli) kendi tanıtımını ve rotalarını hazırlar, en çok "onaya
    // gönderir"; yayına admin alır. Nüfus, bölge ve başkan adının gösterilmesi yalnızca admin'de (Karar, Eren).
    function travelStaff(orgId) {
      return orgId is string && orgId.matches('^bld-.+') && isMemberOf(orgId) && get(orgPath(orgId)).data.modules.hasAny(['seyahat']);
    }
    function travelStaffCan(orgId, actions) {
      return orgId is string && orgId.matches('^bld-.+') && isMemberOf(orgId)
        && get(orgPath(orgId)).data.modules.hasAny(['seyahat'])
        && get(memberPath(orgId)).data.assignments.get('seyahat', []).hasAny(actions);
    }
    function orgProvince(orgId) {
      return get(orgPath(orgId)).data.scope.provinceCode;
    }
    function validTravelRoute(d) {
      return d.keys().hasOnly(['cityId', 'municipalityId', 'theme', 'length', 'title', 'summary', 'durationMinutes', 'stops', 'tips',
             'order', 'status', 'updatedAt'])
        && d.cityId is string && d.cityId.matches('^[0-8][0-9]$')
        && d.theme in ['tarih', 'manevi', 'lezzet', 'doga', 'alisveris', 'kultur', 'aile', 'aksam']
        && d.length in ['kisa', 'yarim', 'tam']
        && d.title is string && d.title.size() >= 2 && d.title.size() <= 60
        && d.summary is string && d.summary.size() <= 300
        && d.durationMinutes is int && d.durationMinutes > 0 && d.durationMinutes <= 1440
        && d.stops is list && d.stops.size() >= 2 && d.stops.size() <= 12
        && d.get('tips', []) is list && d.get('tips', []).size() <= 6
        && d.order is int
        && d.status in ['taslak', 'onay-bekliyor', 'yayinda']
        && d.updatedAt == request.time;
    }
    match /travelRoutes/{id} {
      allow read: if resource == null || resource.data.status == 'yayinda' || isAdmin()
        || travelStaff(resource.data.get('municipalityId', null));
      allow create, update: if validTravelRoute(request.resource.data)
        && (isAdmin()
            || (travelStaffCan(request.resource.data.get('municipalityId', null), resource == null ? ['ekle'] : ['ekle', 'duzenle'])
                && request.resource.data.status in ['taslak', 'onay-bekliyor']
                && request.resource.data.cityId == orgProvince(request.resource.data.municipalityId)
                && (resource == null || resource.data.get('municipalityId', null) == request.resource.data.municipalityId)));
      allow delete: if isAdmin() || travelStaffCan(resource.data.get('municipalityId', null), ['sil']);
    }
    match /travelLocal/{id} {
      allow read: if resource == null || resource.data.status == 'yayinda' || isAdmin();
      allow create, update: if isAdmin() && validTravelStatus(request.resource.data)
        && request.resource.data.keys().hasOnly(['cityId', 'kind', 'title', 'subtitle', 'body', 'badges', 'facts', 'source', 'order', 'status', 'updatedAt'])
        && request.resource.data.cityId is string && request.resource.data.cityId.matches('^[0-8][0-9]$')
        && request.resource.data.kind in ['miras', 'el-sanati', 'lezzet', 'gelenek']
        && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000
        && request.resource.data.get('badges', []) is list && request.resource.data.get('badges', []).size() <= 4
        && request.resource.data.get('facts', []) is list && request.resource.data.get('facts', []).size() <= 8;
      allow delete: if isAdmin();
    }
    function validMunicipal(id, d) {
      return id.matches('^bld-[0-9]{2}(-[a-z0-9-]+)?$')
        && d.keys().hasOnly(['cityId', 'districtId', 'slogan', 'description', 'videoUrl', 'mayorName', 'showMayor', 'zone',
             'population', 'populationYear', 'status', 'updatedAt'])
        && d.cityId is string && d.cityId.matches('^[0-8][0-9]$')
        && d.slogan is string && d.slogan.size() >= 2 && d.slogan.size() <= 60
        && d.description is string && d.description.size() <= 600
        && (!('mayorName' in d) || (d.mayorName is string && d.mayorName.size() <= 80))
        && (!('showMayor' in d) || d.showMayor is bool)
        && (!('zone' in d) || d.zone in ['merkez', 'sahil', 'dag', 'ova'])
        && (!('population' in d) || (d.population is int && d.population >= 0))
        && (!('populationYear' in d) || (d.populationYear is string && d.populationYear.size() <= 10))
        && travelUrlOk(d, 'videoUrl')
        && d.status in ['taslak', 'onay-bekliyor', 'yayinda']
        && d.updatedAt == request.time;
    }
    match /travelMunicipal/{id} {
      allow read: if resource == null || resource.data.status == 'yayinda' || isAdmin() || travelStaff(id);
      allow create, update: if validMunicipal(id, request.resource.data)
        && (isAdmin()
            || (travelStaffCan(id, ['ekle', 'duzenle'])
                && request.resource.data.status in ['taslak', 'onay-bekliyor']
                && request.resource.data.cityId == orgProvince(id)
                && (resource == null
                    ? !request.resource.data.keys().hasAny(['showMayor', 'zone', 'population', 'populationYear'])
                    : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['showMayor', 'zone', 'population', 'populationYear']))));
      allow delete: if isAdmin();
    }

    match /auditLog/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.actorUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && (isAdmin()
            || (request.resource.data.get('region', null) is map
                && regionAllows(request.resource.data.module, request.resource.data.action,
                     request.resource.data.region.get('provinceCode', null),
                     request.resource.data.region.get('districtId', null)))
            // Muhtar kendi mahallesinde.
            || (request.resource.data.get('region', null) is map
                && request.resource.data.region.get('neighbourhoodId', null) is string
                && grantAllows('mahalle-' + request.resource.data.region.neighbourhoodId, request.resource.data.module,
                     request.resource.data.action))
            // Kurum yöneticisi kendi kurumunda (personel işlemleri).
            || (request.resource.data.get('orgId', null) is string && request.resource.data.module == 'kurumlar'
                && isOrgAdminOf(request.resource.data.orgId))
            // Muhtar kendi mahallesinin resmî profilini düzenler.
            || (request.resource.data.module == 'kurumlar' && request.resource.data.action == 'duzenle'
                && request.resource.data.targetId is string && request.resource.data.targetId.matches('^mahalle-.+')
                && isMuhtarOf(request.resource.data.targetId))
            // Kurum personeli kurumun bölümlerinde (duyuru hazırlama, onay).
            || (request.resource.data.get('orgId', null) is string && request.resource.data.module in ['gonderiler', 'etkinlikler', 'seyahat']
                && staffCan(request.resource.data.orgId, request.resource.data.module, request.resource.data.action)));
      allow update, delete: if false;
    }
  }
}
