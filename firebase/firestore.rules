        && after.unread[before.startedBy] == before.unread.get(before.startedBy, 0) + 1
        && after.unread.get(ownerOfChat(before), 0) == before.unread.get(ownerOfChat(before), 0)
        && after.updatedAt == request.time;
    }
    function staffReading(before, after) {
