    // Gönderi videosu (en çok 60 sn): fotoğrafla birlikte olmaz; dosya bu gönderinin klasöründe `video.mp4` ya da `.mov`.
    // Süreyi telefon bildirir; dosya boyutunu (40 MB) Storage kuralı sınırlar.
    function validPostVideo(d, id) {
      let v = d.get('video', null);
      let b = 'posts/' + d.authorUid + '/' + id + '/video.';
      return !('video' in d)
        || (!('photos' in d) && v is map && v.keys().hasOnly(['path', 'url', 'width', 'height', 'durationSec'])
            && (v.path == b + 'mp4' || v.path == b + 'mov')
            && v.url is string && v.url.size() <= 600
            && v.width is int && v.height is int
            && v.durationSec is int && v.durationSec >= 1 && v.durationSec <= 60);
    }
    function canSeePost(d) {
