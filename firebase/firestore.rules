      function _k28(nw, od) {
        return verified() && od.status == 'yayinda' && request.time < od.endsAt
        && nw.diff(od).affectedKeys().hasOnly(['counts', 'voteCount'])
        && nw.voteCount == od.voteCount + 1
        && !exists(pollVotePath(id + '_' + request.auth.uid))
        && existsAfter(pollVotePath(id + '_' + request.auth.uid))
        && nw.counts.diff(od.counts).affectedKeys()
             == [getAfter(pollVotePath(id + '_' + request.auth.uid)).data.optionId].toSet()
        && nw.counts[getAfter(pollVotePath(id + '_' + request.auth.uid)).data.optionId]
