    }

    // Mesaj, aynı yazımdaki sohbet özetinin son mesajıdır; iki taraf arasında engel yoktur.
    function messageFits(chat, mid) {
      return chat.last.id == mid
        && ((request.auth.uid in chat.members && notBlockedPair(request.auth.uid, otherOf(chat.members)))
            || (isBusinessStaff(chat) && notBlockedPair(request.auth.uid, chat.startedBy) && notBlockedPair(ownerOfChat(chat), chat.startedBy)));
    }

    match /chats/{id} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members || isBusinessStaff(resource.data));
      function _k100(nw) {
