    // Yeni bağlanan görsel bağlayanın kendi klasöründen olmalı (başkasının dosyası bağlanıp kaldırılarak sunucuya
    // sildirilemesin); değişmeden kalan görsel başka bir yetkilinin yüklediği olabilir.
    function storageUrlOk(u, encodedPath) {
      return u is string && u.size() <= 700
        && u.matches('(https://firebasestorage[.]googleapis[.]com|http://(127[.]0[.]0[.]1|localhost|10[.]0[.]2[.]2):9199)/v0/b/[^/?]+/o/'
            + encodedPath + '[?].*');
    }
    function validMediaBy(p, kind, uid) {
      return p is map && p.keys().hasOnly(['path', 'url', 'width', 'height'])
        && p.path is string && p.path.matches('media/' + uid + '/' + kind + '/[A-Za-z0-9]{10,40}[.]jpg')
        && storageUrlOk(p.url, p.path.replace('/', '%2F'))
        && p.width is int && p.height is int && p.width > 0 && p.width <= 4000 && p.height > 0 && p.height <= 4000;
    }
    // Yazanın kendisi ve sunucu saati (yönetici ayarlarında).
    function stamped(d) {
      return d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function mediaKeptOrOwn(d, key, kind) {
      return !(key in d)
        || (resource != null && resource.data.get(key, null) == d[key])
        || validMediaBy(d[key], kind, request.auth.uid);
    }
    // İşletme vitrini: kademeye göre en çok fotoğraf (panel > Sınırlar; kesin üst sınır 30). Kural motorunun işlem
    // sınırı (1000) yüzünden tek tek fotoğraf burada denetlenmez: uygulama yalnızca kendi depomuzdaki adresleri gösterir,
    // sunucu da kayıttan çıkan dosyadan yalnızca sahibin ve yetkililerin yüklediğini siler.
    function vitrinOk(d) {
      let l = d.get('gallery', []);
      // Eski kayıtlardaki 'premium' Pro, 'standart' Ücretsiz sayılır.
      let pro = d.get('membership', {}).get('tier', '') in ['pro', 'premium'];
      return l is list && (l.size() == 0
        || (resource != null && resource.data.get('gallery', []) == l)
        || (l.size() <= 30 && l.size() <= limitOf(pro ? 'vitrinPro' : 'vitrinUcretsiz', pro ? 10 : 1)));
    }
    // Gönderi fotoğrafları (en çok 10, albüm): dosya paylaşanın klasöründe, bu gönderinin kimliğiyle ve sırayla
