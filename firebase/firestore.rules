    // İşletme ekibi: mesaj izni olan yetkili, işletmeye yazılan sohbeti görür ve işletme adına cevaplar. Sohbetin üyesi
    // değildir; işletme tarafının okunmamış sayacı sahibininkidir (sahip ve yetkililer için ortak).
    function isBusinessStaff(chat) {
      return signedIn() && chat.get('context', null) != null
        && request.auth.uid in get(/databases/$(database)/documents/businesses/$(chat.context.id)).data.get('managerUids', [])
        && get(/databases/$(database)/documents/businesses/$(chat.context.id)).data.managers[request.auth.uid].get('messages', false) == true;
    }
    function ownerOfChat(chat) {
      return chat.members[0] == chat.startedBy ? chat.members[1] : chat.members[0];
