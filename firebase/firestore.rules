        && d.category in ['elektronik', 'ev-mobilya', 'ev-aletleri', 'giyim', 'cocuk', 'kitap-hobi', 'spor', 'diger']
        && d.condition in ['sifir', 'az-kullanilmis', 'kullanilmis', 'tamir']
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 1500
        && d.swapFor is string && d.swapFor.size() <= 120
        && (d.kind in ['satilik', 'kiralik']
            ? (d.price is int && d.price >= 1 && d.price <= 10000000)
            : d.price == null)
