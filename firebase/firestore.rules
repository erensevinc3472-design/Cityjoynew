      let b = 'posts/' + d.authorUid + '/' + id + '/';
      return !('photos' in d)
        || (l is list && l.size() >= 1 && l.size() <= 10
            && l[0].path == b + '0.jpg'
            && (l.size() < 2 || l[1].path == b + '1.jpg')
            && (l.size() < 3 || l[2].path == b + '2.jpg')
            && (l.size() < 4 || l[3].path == b + '3.jpg')
            && (l.size() < 5 || l[4].path == b + '4.jpg')
            && (l.size() < 6 || l[5].path == b + '5.jpg')
            && (l.size() < 7 || l[6].path == b + '6.jpg')
            && (l.size() < 8 || l[7].path == b + '7.jpg')
            && (l.size() < 9 || l[8].path == b + '8.jpg')
