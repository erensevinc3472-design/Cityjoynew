rules_version = '2';

// Dosya deposu (Firebase Storage; Blaze plan ister). Varsayılan kapalı: yalnızca aşağıda açılan yollar kullanılır.
service firebase.storage {
  match /b/{bucket}/o {
    // Keşfet gönderi fotoğrafları: posts/{uid}/{postId}/{sıra}.jpg (sıra 0-9, albümde en çok 10). Telefonda küçültülmüş JPEG, en çok
    // 1,5 MB. Yalnızca sahibi yükler; yüklenen dosyanın yerine başkası yazılamaz (düzenleme yok, yalnızca yeni dosya).
    // Gönderinin kimin göreceği Firestore'daki gönderi kaydına bağlıdır; dosyayı giriş yapmış kişi okur. Silmeyi gönderi
    // kaldırılınca ya da hesap silinince sunucu yapar; sahibi de yarım kalan yüklemesini silebilir.
    match /posts/{uid}/{postId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && ((file.matches('[0-9][.]jpg')
              && request.resource.contentType == 'image/jpeg'
              && request.resource.size > 0 && request.resource.size <= 1500000)
            // Gönderi videosu (en çok 60 sn, 40 MB): video.mp4 ya da iPhone'da video.mov.
            || (file.matches('video[.](mp4|mov)')
              && request.resource.contentType in ['video/mp4', 'video/quicktime']
              && request.resource.size > 0 && request.resource.size <= 40000000));
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Diğer görseller: media/{uid}/{tür}/{rastgele}.jpg (etkinlik kapağı, kurum logosu, işletme logosu ve vitrini,
    // profil fotoğrafı, Çarşı ilan fotoğrafları, aktivite kapağı, Seyahat kapakları).
    // Yükleyen kendi klasörüne yükler; görseli bir kayda (etkinlik, kurum, işletme) bağlamaya kimin yetkisi olduğunu
    // Firestore kuralı denetler. Kayıttan çıkan dosyayı sunucu siler.
    match /media/{uid}/{kind}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && kind in ['etkinlik', 'kurum', 'isletme-logo', 'isletme-vitrin', 'profil', 'ilan', 'aktivite', 'seyahat']
        && file.matches('[A-Za-z0-9]{10,40}[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0 && request.resource.size <= 1500000;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Listelerde gösterilen küçük kopyalar (640 piksel): thumbs/{asıl yol}. Yalnızca sunucu yazar ve siler.
    match /thumbs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
