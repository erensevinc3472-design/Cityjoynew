rules_version = '2';

// Dosya deposu (Firebase Storage; Blaze plan ister). Varsayılan kapalı: yalnızca aşağıda açılan yollar kullanılır.
service firebase.storage {
  match /b/{bucket}/o {
    // Keşfet gönderi fotoğrafları: posts/{uid}/{postId}/{sıra}.jpg (sıra 0-3). Telefonda küçültülmüş JPEG, en çok
    // 1,5 MB. Yalnızca sahibi yükler; yüklenen dosyanın yerine başkası yazılamaz (düzenleme yok, yalnızca yeni dosya).
    // Gönderinin kimin göreceği Firestore'daki gönderi kaydına bağlıdır; dosyayı giriş yapmış kişi okur. Silmeyi gönderi
    // kaldırılınca ya da hesap silinince sunucu yapar; sahibi de yarım kalan yüklemesini silebilir.
    match /posts/{uid}/{postId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && file.matches('[0-3][.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0 && request.resource.size <= 1500000;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
