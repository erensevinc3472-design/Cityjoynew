{
  "name": "cityjoy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "firebase",
    "functions"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace packages/shared",
    "locations:build": "node packages/shared/scripts/build-locations.mjs",
    "panel": "npm run dev --workspace apps/panel",
    "env:write": "node scripts/write-env.mjs",
    "test:rules": "npm test --workspace firebase",
    "test:functions": "npm test --workspace functions",
    "functions:build": "npm run build --workspace functions"
  },
  "devDependencies": {
    "write-excel-file": "4.1.1"
  }
}
