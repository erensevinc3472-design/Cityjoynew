{
  "expo": {
    "name": "CityJoy",
    "slug": "cityjoy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cityjoy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081F24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081F24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
            "ios": [
              "tr",
              "en",
              "de",
              "ar",
              "ru"
            ],
            "android": [
              "tr",
              "en",
              "de",
              "ar",
              "ru"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CityJoy konumunuzu yalnızca bir özelliği kullanırken alır: SOS gönderdiğinizde konumunuzu aile listenizdeki kişilere iletmek, Yoldayım ekranında yolunuzun üstündeki mola yerlerini göstermek ve işletmenizin yerini haritada işaretlemek için.",
          "locationAlwaysAndWhenInUsePermission": "SOS gönderdiğinizde ekran kilitlense ya da uygulama kapansa da konumunuz aile listenizdeki kişilere iletilmeye devam eder. Arka planda konum yalnızca SOS süresince (en çok 2 saat) kullanılır. Uygulama açıkken Yoldayım ekranında yol üstü mola yerlerini göstermek ve işletmenizin yerini işaretlemek için de kullanılır.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C0392B"
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "CityJoy, Keşfet'te paylaşacağın fotoğrafları seçebilmen için galerine erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "ar": "./locales/ar.json",
      "ru": "./locales/ru.json"
    }
  }
}
