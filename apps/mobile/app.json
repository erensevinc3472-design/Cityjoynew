{
  "expo": {
    "name": "CityJoy",
    "slug": "cityjoy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cityjoy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081F24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081F24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
            "ios": [
              "tr",
              "en",
              "de",
              "ar",
              "ru"
            ],
            "android": [
              "tr",
              "en",
              "de",
              "ar",
              "ru"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CityJoy, SOS gönderdiğinizde konumunuzu yalnızca aile listenizdeki kişilere iletmek için kullanır.",
          "locationAlwaysAndWhenInUsePermission": "SOS gönderdiğinizde ekran kilitlense ya da uygulama kapansa da konumunuz aile listenizdeki kişilere iletilmeye devam eder. Yalnızca SOS süresince (en çok 2 saat) kullanılır; başka zaman arka planda konum alınmaz.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C0392B"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
